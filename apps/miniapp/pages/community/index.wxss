.page {
  min-height: 100vh;
  padding: 116rpx 40rpx calc(168rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 0 0 30rpx;
}

.title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.identity-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 0 46rpx;
  padding: 24rpx 28rpx;
  border: 1rpx dashed rgba(218, 195, 153, 0.9);
  border-radius: 38rpx;
  background: rgba(255, 253, 248, 0.2);
}

.identity-row,
.identity-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.identity-label {
  color: rgba(134, 166, 210, 0.82);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.4;
}

.identity-chip,
.identity-action,
.quick-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.86);
  color: var(--xy-color-muted);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
}

.identity-action.primary {
  border-color: transparent;
  background: var(--xy-color-primary);
  color: #ffffff;
}

.identity-name {
  max-width: 330rpx;
  overflow: hidden;
  color: #6b8db3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-link {
  color: #9b7927;
}

.notice {
  margin: 0 0 20rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.68);
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.7;
}

.category-tabs-scroll {
  width: 100%;
  padding: 0;
  border-bottom: 1rpx solid rgba(233, 221, 191, 0.86);
  overflow: hidden;
  white-space: nowrap;
}

.category-tab-row {
  display: flex;
  align-items: flex-end;
  gap: 40rpx;
  width: max-content;
  min-width: 100%;
}

.category-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  gap: 6rpx;
  margin: 0 !important;
  padding: 20rpx 0 !important;
  background: transparent;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1;
}

.active-category {
  color: var(--xy-color-primary);
}

.litter-chevron {
  display: inline-block;
  color: inherit;
  font-size: 20rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.litter-chevron.open {
  transform: rotate(180deg) translateY(1rpx);
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  transform: translateX(-50%);
}

.litter-tabs-scroll {
  width: 100%;
  margin: 20rpx 0 0;
  overflow: hidden;
  white-space: nowrap;
}

.litter-tabs {
  display: flex;
  flex-wrap: nowrap;
  gap: 14rpx;
  width: max-content;
  min-width: 100%;
}

.litter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin: 0;
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: #6b8db3;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
}

.active-litter {
  border-color: var(--xy-color-accent);
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.category-tab::after,
.litter-tab::after,
.quick-link::after,
.identity-action::after,
.retry-button::after,
.like-button::after,
.floating-publish::after {
  border: 0;
}

.state,
.empty-card {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.empty-card {
  margin-top: 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 44rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 28rpx;
}

.post-card {
  padding: 32rpx 40rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.72);
  border-radius: 48rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.post-head,
.post-foot,
.author-row,
.links {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author-block {
  min-width: 0;
}

.author-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.author,
.date,
.content,
.meta {
  display: block;
}

.author {
  max-width: 300rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.role-pill,
.pin,
.category,
.link-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.role-pill {
  padding: 4rpx 14rpx;
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.pin {
  padding: 4rpx 12rpx;
  background: #fff0c4;
  color: var(--xy-color-accent-text);
}

.category {
  flex-shrink: 0;
  color: rgba(180, 135, 37, 0.82);
  font-size: 21rpx;
  font-weight: 700;
}

.content {
  margin-top: 24rpx;
  color: var(--xy-color-text);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.post-images {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.single-image-grid {
  grid-template-columns: 1fr;
}

.two-image-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.three-image-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.post-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  margin-top: 22rpx;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.post-images .post-image {
  margin-top: 0;
}

.single-image-grid .post-image {
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
}

.links {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
}

.link-pill {
  max-width: 100%;
  padding: 8rpx 18rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--xy-color-heading);
}

.cat-link-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cat-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.82);
  border-radius: 999rpx;
  background: var(--xy-gradient-cream);
}

.cat-avatar-icon {
  width: 34rpx;
  height: 34rpx;
  transform: scale(1.45);
  transform-origin: center;
}

.link-pill.litter {
  flex-shrink: 0;
  padding: 4rpx 10rpx;
  background: #fbf1cf;
  color: var(--xy-color-accent-text);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.post-foot {
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 22rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.like-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: auto !important;
  min-width: 0;
  height: 44rpx;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx;
  background: transparent;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.comment-count {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.like-button.liked {
  color: var(--xy-color-violet);
}

.like-icon,
.comment-icon {
  width: 30rpx;
  height: 30rpx;
}

.floating-publish {
  position: fixed;
  right: 40rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  z-index: 5;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx !important;
  height: 88rpx;
  min-width: 0;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx;
  background: #9aa4d8;
  line-height: 88rpx;
  box-shadow: 0 16rpx 34rpx rgba(91, 127, 168, 0.18);
}

.publish-icon {
  width: 40rpx;
  height: 40rpx;
}
