<view class="page">
  <view class="header">
    <view>
      <text class="title">猫友圈</text>
      <text class="subtitle">猫舍日常、碎碎念和家长分享</text>
    </view>
  </view>

  <view wx:if="{{showMyCats}}" class="quick-links">
    <button class="quick-link" bindtap="openMyCats">
      <image class="quick-link-icon" src="../../assets/tabbar/cats-active.png" mode="aspectFit" />
      <text>我的猫咪</text>
    </button>
  </view>

  <scroll-view class="category-tabs-scroll" scroll-x enable-flex>
    <view class="category-tab-row">
      <button
        wx:for="{{categoryTabs}}"
        wx:key="key"
        class="{{activeCategory === item.key ? 'category-tab active-category' : 'category-tab'}}"
        data-key="{{item.key}}"
        bindtap="setCategory"
      >
        {{item.label}}
        <text wx:if="{{activeCategory === item.key}}" class="tab-line"></text>
      </button>
      <button class="{{activeLitterId ? 'category-tab active-category' : 'category-tab'}}" bindtap="toggleLitter">
        窝次{{activeLitterId ? "：" + activeLitterLabel : ""}}
        <text wx:if="{{activeLitterId}}" class="tab-line"></text>
      </button>
    </view>
  </scroll-view>

  <view wx:if="{{litterOpen}}" class="litter-tabs">
    <button
      wx:for="{{litterFilters}}"
      wx:key="id"
      class="{{activeLitterId === item.id ? 'litter-tab active-litter' : 'litter-tab'}}"
      data-id="{{item.id}}"
      bindtap="setLitter"
    >
      {{item.name}}
    </button>
  </view>

  <view wx:if="{{isLoading}}" class="state">正在加载猫友圈...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{!posts.length}}" class="empty-card">当前筛选下还没有动态。</view>

  <view wx:else class="feed">
    <view
      wx:for="{{posts}}"
      wx:key="id"
      wx:for-index="index"
      class="post-card"
      data-id="{{item.id}}"
      bindtap="openPost"
    >
      <view class="post-head">
        <view class="author-block">
          <view class="author-row">
            <text class="author">{{item.author}}</text>
            <text class="role-pill">{{item.roleLabel}}</text>
            <text wx:if="{{item.isPinned}}" class="pin">置顶</text>
          </view>
          <text class="date">{{item.date}}</text>
        </view>
        <text class="category">{{item.category}}</text>
      </view>

      <text class="content">{{item.content}}</text>

      <view wx:if="{{item.images.length}}" class="{{item.imageGridClass}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="image"
          wx:for-index="imageIndex"
          wx:key="id"
          class="post-image"
          src="{{image.url}}"
          mode="aspectFill"
          data-post-index="{{index}}"
          data-image-index="{{imageIndex}}"
          catchtap="previewImage"
        />
      </view>

      <view wx:if="{{item.linkedLitters.length || item.linkedCats.length}}" class="links">
        <view wx:for="{{item.linkedCats}}" wx:key="id" class="cat-link-pill">
          <view class="cat-avatar">
            <image class="cat-avatar-icon" src="../../assets/illustrations/cat-icon.png" mode="aspectFit" />
          </view>
          <text>{{item.name}}</text>
        </view>
        <text wx:for="{{item.linkedLitters}}" wx:key="id" class="link-pill litter">{{item.name}}</text>
      </view>

      <view class="post-foot">
        <button
          class="{{item.likedByMe ? 'like-button liked' : 'like-button'}}"
          data-id="{{item.id}}"
          catchtap="toggleLike"
        >
          <image
            class="like-icon"
            src="{{item.likedByMe ? '../../assets/illustrations/paw-like-active.png' : '../../assets/illustrations/paw-like.png'}}"
            mode="aspectFit"
          />
          <text>{{item.footerLikeLabel}}</text>
        </button>
        <view class="comment-count">
          <image class="comment-icon" src="../../assets/illustrations/chat-bubble-icon.png" mode="aspectFit" />
          <text>{{item.footerCommentLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <button wx:if="{{canPublish}}" class="floating-publish" bindtap="openPublish">
    <image class="publish-icon" src="../../assets/illustrations/plus-icon.png" mode="aspectFit" />
  </button>
</view>
