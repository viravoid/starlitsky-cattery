<view class="page">
  <view class="hero">
    <text class="eyebrow">Parent Verification</text>
    <text class="title">家长认证申请</text>
    <text class="subtitle">填写申请后由主理人审核；审核通过后才会开通家长权限。</text>
  </view>

  <view wx:if="{{application}}" class="status-panel">
    <text class="section-title">我的申请状态</text>
    <text class="status {{applicationStatusClass}}">{{applicationStatusLabel}}</text>
    <text class="muted">提交时间：{{application.createdAt}}</text>
    <text wx:if="{{application.adminNote}}" class="muted">审核备注：{{application.adminNote}}</text>
    <text wx:if="{{application.status === 'rejected'}}" class="muted">可修改资料重新申请；提交间隔至少一小时。</text>
  </view>

  <block wx:if="{{!application || application.status === 'rejected'}}">
  <view class="panel">
    <text class="section-title">家长资料</text>
    <view class="field">
      <text>展示昵称</text>
      <input class="field-control" placeholder="社区中显示的名称" value="{{displayName}}" bindinput="onDisplayNameInput" />
    </view>
    <view class="field">
      <text>性别（选填）</text>
      <view class="gender-row">
        <button class="{{applicantGender === 'male' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="male" bindtap="setApplicantGender">男</button>
        <button class="{{applicantGender === 'female' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="female" bindtap="setApplicantGender">女</button>
        <button class="{{applicantGender === '' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="" bindtap="setApplicantGender">不透露</button>
      </view>
    </view>
  </view>

  <view class="panel">
    <text class="section-title">联系方式</text>
    <button wx:if="{{phoneCapabilityEnabled && !verifiedPhone}}" class="secondary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" disabled="{{isVerifyingPhone}}">授权微信手机号（可选）</button>
    <text wx:if="{{verifiedPhone}}" class="hint">已授权手机号：{{verifiedPhone}}</text>
    <view class="field">
      <text>微信号</text>
      <input class="field-control" placeholder="微信不向小程序自动提供，可手动填写" value="{{contactWechat}}" bindinput="onContactWechatInput" />
    </view>
  </view>

  <view class="panel">
    <text class="section-title">我的猫</text>
    <view class="switch-row">
      <button class="{{catMode === 'existing' ? 'active' : 'secondary'}}" style="width: 100%;" bindtap="useExistingCat">猫库选择</button>
      <button class="{{catMode === 'unlisted' ? 'active' : 'secondary'}}" style="width: 100%;" bindtap="useUnlistedCat">认领未公开猫咪</button>
      <button class="{{catMode === 'new' ? 'active' : 'secondary'}}" style="width: 100%;" bindtap="useNewCat">填写新猫</button>
    </view>

    <view wx:if="{{catMode === 'existing'}}">
      <view class="field">
        <text>搜索猫咪</text>
        <input class="field-control" placeholder="至少输入两个字搜索公开猫咪" value="{{catQuery}}" bindinput="onCatQueryInput" />
      </view>
      <button class="secondary" style="width: 100%;" loading="{{isSearchingCats}}" bindtap="onSearchCats">搜索</button>
      <view class="cat-list">
        <button
          wx:for="{{cats}}"
          wx:key="id"
          class="{{existingCatId === item.id ? 'cat-row selected' : 'cat-row'}}"
          style="width: 100%;"
          data-cat-id="{{item.id}}"
          data-cat-name="{{item.name}}"
          bindtap="onSelectExistingCat"
        >
          {{item.name}}
        </button>
      </view>
      <text class="hint">找不到猫咪？已有档案请选择「认领未公开猫咪」；确实没有档案才选择「填写新猫」。</text>
    </view>

    <view wx:if="{{catMode === 'unlisted' || catMode === 'new'}}">
      <view class="field">
        <text>猫咪名字</text>
        <input class="field-control" placeholder="必填" value="{{newCatName}}" bindinput="onNewCatNameInput" />
      </view>
      <view wx:if="{{catMode === 'unlisted'}}" class="field">
        <text>识别说明</text>
        <textarea class="field-control textarea-control" placeholder="颜色、到家时间等供主理人核对的信息" value="{{unlistedCatIdentification}}" bindinput="onUnlistedCatIdentificationInput" />
      </view>
      <block wx:if="{{catMode === 'new'}}">
      <view class="field">
        <text>性别</text>
        <view class="gender-row">
          <button class="{{newCatGender === 'male' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="male" bindtap="setNewCatGender">弟弟</button>
          <button class="{{newCatGender === 'female' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="female" bindtap="setNewCatGender">妹妹</button>
          <button class="{{newCatGender === 'unknown' ? 'gender-choice active' : 'gender-choice'}}" style="width: auto;" data-gender="unknown" bindtap="setNewCatGender">暂不确定</button>
        </view>
      </view>
      <view class="field">
        <text>颜色</text>
        <input class="field-control" placeholder="可选" value="{{newCatColor}}" bindinput="onNewCatColorInput" />
      </view>
      <view class="field">
        <text>生日</text>
        <input class="field-control" placeholder="YYYY-MM-DD，可选" value="{{newCatBirthday}}" bindinput="onNewCatBirthdayInput" />
      </view>
      <view class="field">
        <text>到家日期</text>
        <input class="field-control" placeholder="YYYY-MM-DD，可选" value="{{newCatArrivedAt}}" bindinput="onNewCatArrivedAtInput" />
      </view>
      <view class="field">
        <text>性格/备注</text>
        <textarea class="field-control textarea-control" placeholder="可选" value="{{newCatPersonality}}" bindinput="onNewCatPersonalityInput" />
      </view>
      </block>
    </view>
  </view>

  <button class="submit" style="width: 100%;" loading="{{isSubmitting}}" bindtap="onSubmit">提交家长申请</button>
  </block>
</view>
