.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(80rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
  color: var(--xy-color-text);
}

.hero,
.panel,
.status-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.hero {
  padding: 12rpx 4rpx 10rpx;
}

.panel,
.status-panel {
  padding: 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.status-panel {
  align-items: flex-start;
}

.eyebrow {
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.subtitle,
.muted,
.hint {
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.section-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  color: var(--xy-color-heading);
  font-size: 24rpx;
  font-weight: 700;
}

.field-control {
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 28rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-text);
  font-size: 27rpx;
}

.textarea-control {
  min-height: 160rpx;
  padding-top: 20rpx;
  line-height: 1.65;
}

.secondary,
.active,
.cat-row,
.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  margin: 0;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.35;
}

.secondary::after,
.active::after,
.cat-row::after,
.submit::after {
  border: 0;
}

.secondary {
  border: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.82);
  color: var(--xy-color-accent-text);
}

.active {
  border: 1rpx solid rgba(231, 193, 93, 0.78);
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.switch-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.cat-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 14rpx;
}

.cat-row {
  justify-content: flex-start;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  color: var(--xy-color-text);
  text-align: left;
}

.selected {
  border-color: var(--xy-color-accent);
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.status {
  display: flex;
  align-items: center;
  align-self: flex-start;
  width: auto;
  max-width: 100%;
  box-sizing: border-box;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  line-height: 1.35;
}

.pending {
  background: #fff4d6;
  color: var(--xy-color-accent-text);
}

.approved {
  background: #ecfdf5;
  color: #047857;
}

.rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.submit {
  width: 100%;
  margin: 8rpx 0 40rpx;
  min-height: 88rpx;
}
