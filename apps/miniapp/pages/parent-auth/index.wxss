.page {
  min-height: 100vh;
  background: #fffaf1;
  color: #1f2937;
  padding: 28rpx;
}

.hero,
.panel,
.status-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hero {
  padding: 20rpx 0 8rpx;
}

.panel,
.status-panel {
  border: 1rpx solid #e5dfd3;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 24rpx;
}

.eyebrow {
  color: #7a9ac0;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle,
.muted,
.hint {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
  font-weight: 700;
}

input,
textarea {
  min-height: 72rpx;
  border: 1rpx solid #d7dce2;
  border-radius: 12rpx;
  background: #f9fafb;
  color: #111827;
  font-size: 28rpx;
  padding: 0 20rpx;
}

textarea {
  min-height: 148rpx;
  padding-top: 18rpx;
}

button {
  border-radius: 12rpx;
  background: #7a9ac0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.secondary {
  border: 1rpx solid #d7dce2;
  background: #ffffff;
  color: #374151;
}

.active {
  background: #5d7ea6;
  color: #ffffff;
}

.switch-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.cat-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}

.cat-row {
  border: 1rpx solid #d7dce2;
  background: #ffffff;
  color: #374151;
  text-align: left;
}

.selected {
  border-color: #7a9ac0;
  background: #eef5fb;
  color: #244b73;
}

.status {
  width: fit-content;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  padding: 8rpx 16rpx;
}

.pending {
  background: #fff7ed;
  color: #c2410c;
}

.approved {
  background: #ecfdf5;
  color: #047857;
}

.rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.submit {
  width: 100%;
  min-height: 84rpx;
  margin: 8rpx 0 40rpx;
}
