.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(80rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
  color: var(--xy-color-text);
}

.hero,
.panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.hero {
  gap: 8rpx;
  padding: 12rpx 4rpx 10rpx;
}

.panel {
  padding: 30rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.success-panel {
  align-items: center;
  padding: 42rpx 30rpx;
  border-color: rgba(134, 166, 210, 0.28);
  background: var(--xy-color-surface);
  text-align: center;
}

.danger-panel {
  align-items: center;
  padding: 42rpx 30rpx;
  border-color: rgba(196, 106, 106, 0.18);
  background: var(--xy-color-surface);
  text-align: center;
}

.status-art {
  width: 104rpx;
  height: 104rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(134, 166, 210, 0.24);
  border-radius: 999rpx;
  background: rgba(212, 231, 242, 0.28);
  opacity: 0.82;
}

.eyebrow {
  display: block;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  line-height: 1.35;
  text-transform: uppercase;
}

.title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.subtitle,
.muted,
.hint {
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.section-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: var(--xy-primary-cta-height);
  margin-top: 10rpx;
  padding: 0 28rpx;
  border-radius: var(--xy-primary-cta-radius);
  background: var(--xy-primary-cta-background);
  color: var(--xy-primary-cta-color);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
  box-shadow: var(--xy-primary-cta-shadow);
}

.submit::after {
  border: 0;
}
