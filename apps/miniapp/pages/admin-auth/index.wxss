.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(80rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
  color: var(--xy-color-text);
}

.hero,
.panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.hero {
  padding: 12rpx 4rpx 10rpx;
}

.panel {
  padding: 30rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.success-panel {
  border-color: rgba(134, 239, 172, 0.72);
  background: #f0fdf4;
}

.danger-panel {
  border-color: rgba(252, 165, 165, 0.72);
  background: #fef2f2;
}

.eyebrow {
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.subtitle,
.muted,
.hint {
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.7;
}

.section-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.submit {
  width: 100%;
  min-height: 84rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: var(--xy-color-violet);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.submit::after {
  border: 0;
}
