.page {
  min-height: 100vh;
  background: #fffaf1;
  color: #1f2937;
  padding: 28rpx;
}

.hero,
.panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.hero {
  padding: 20rpx 0 8rpx;
}

.panel {
  border: 1rpx solid #e5dfd3;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 24rpx;
}

.success-panel {
  border-color: #86efac;
  background: #f0fdf4;
}

.danger-panel {
  border-color: #fca5a5;
  background: #fef2f2;
}

.eyebrow {
  color: #7a9ac0;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.subtitle,
.muted,
.hint {
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.6;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.submit {
  width: 100%;
  min-height: 84rpx;
  border-radius: 12rpx;
  background: #7a9ac0;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  margin-top: 10rpx;
}
