<view class="page">
  <view class="header">
    <text class="title">{{title}}</text>
  </view>

  <view wx:if="{{isLoading}}" class="state">正在加载动态...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{!posts.length}}" class="empty-card">当前还没有关联动态。</view>

  <view wx:else class="feed">
    <view
      wx:for="{{posts}}"
      wx:key="id"
      wx:for-index="index"
      class="post-card"
      data-id="{{item.id}}"
      bindtap="openPost"
    >
      <view class="post-head">
        <view class="author-block">
          <view class="author-row">
            <text class="author">{{item.author}}</text>
            <text class="role-pill">{{item.roleLabel}}</text>
            <text wx:if="{{item.isPinned}}" class="pin">置顶</text>
          </view>
          <text class="date">{{item.date}}</text>
        </view>
        <text class="category">{{item.category}}</text>
      </view>

      <text class="content">{{item.content}}</text>

      <view wx:if="{{item.images.length}}" class="{{item.imageGridClass}}">
        <image
          wx:for="{{item.images}}"
          wx:for-item="image"
          wx:for-index="imageIndex"
          wx:key="id"
          class="post-image"
          src="{{image.url}}"
          mode="aspectFill"
          data-post-index="{{index}}"
          data-image-index="{{imageIndex}}"
          catchtap="previewImage"
        />
      </view>

      <view wx:if="{{item.linkedLitters.length || item.linkedCats.length}}" class="links">
        <view wx:for="{{item.linkedCats}}" wx:key="id" class="cat-link">
          <view class="cat-avatar">
            <image class="cat-avatar-icon" src="../../assets/illustrations/cat-icon.png" mode="aspectFit" />
          </view>
          <text>{{item.name}}</text>
        </view>
        <text wx:for="{{item.linkedLitters}}" wx:key="id" class="link-pill litter">{{item.name}}</text>
      </view>

      <view class="post-foot">
        <button class="{{item.likedByMe ? 'like-button liked' : 'like-button'}}" data-id="{{item.id}}" catchtap="toggleLike">
          <image class="foot-icon" src="{{item.likedByMe ? '../../assets/illustrations/paw-like-active.png' : '../../assets/illustrations/paw-like.png'}}" mode="aspectFit" />
          <text>{{item.footerLikeLabel}}</text>
        </button>
        <view class="comment-count">
          <image class="foot-icon" src="../../assets/illustrations/chat-bubble-icon.png" mode="aspectFit" />
          <text>{{item.footerCommentLabel}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
