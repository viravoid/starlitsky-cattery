.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(88rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding-bottom: 20rpx;
}

.title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.state,
.empty-card {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.empty-card {
  margin-top: 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 44rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  padding: 32rpx 40rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.72);
  border-radius: 48rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.post-head,
.author-row,
.links,
.post-foot,
.like-button,
.comment-count {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author-block {
  min-width: 0;
}

.author-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.author,
.date,
.content {
  display: block;
}

.author {
  max-width: 300rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.role-pill,
.pin,
.category,
.link-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.role-pill {
  padding: 4rpx 14rpx;
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.pin {
  padding: 4rpx 12rpx;
  background: #fff0c4;
  color: var(--xy-color-accent-text);
}

.category {
  flex-shrink: 0;
  color: rgba(180, 135, 37, 0.82);
}

.content {
  margin-top: 24rpx;
  color: var(--xy-color-text);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.post-images {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.single-image-grid {
  grid-template-columns: 1fr;
}

.two-image-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.three-image-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.post-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.single-image-grid .post-image {
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
}

.links {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.cat-link {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: var(--xy-color-heading);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cat-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.82);
  border-radius: 999rpx;
  background: var(--xy-gradient-cream);
}

.cat-avatar-icon {
  width: 34rpx;
  height: 34rpx;
}

.link-pill {
  max-width: 100%;
  padding: 8rpx 18rpx;
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.post-foot {
  align-items: center;
  gap: 24rpx;
  margin-top: 22rpx;
}

.like-button,
.comment-count {
  align-items: center;
  gap: 8rpx;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.like-button {
  padding: 0;
  background: transparent;
}

.like-button.liked {
  color: var(--xy-color-violet);
}

.foot-icon {
  width: 32rpx;
  height: 32rpx;
}

.retry-button::after,
.like-button::after {
  border: 0;
}
