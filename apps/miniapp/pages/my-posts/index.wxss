.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.notice,
.empty-card,
.post-card {
  border: 1rpx solid var(--xy-color-border);
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.notice {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.state,
.empty-card {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.empty-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-radius: 44rpx;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button,
.text-link,
.action-button {
  margin: 0;
  border-radius: 999rpx;
  font-size: 25rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  line-height: 72rpx;
}

.text-link {
  padding: 0;
  background: transparent;
  color: var(--xy-color-violet);
  font-weight: 600;
  line-height: 1.5;
}

.feed {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.post-card {
  border-radius: 40rpx;
  overflow: hidden;
}

.post-main {
  padding: 32rpx 36rpx 24rpx;
}

.post-head,
.actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.author,
.date,
.content,
.meta {
  display: block;
}

.author {
  color: var(--xy-color-heading);
  font-size: 27rpx;
  font-weight: 700;
}

.date,
.meta {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.category {
  flex-shrink: 0;
  color: rgba(180, 135, 37, 0.82);
  font-size: 21rpx;
  font-weight: 700;
}

.content {
  margin-top: 22rpx;
  color: var(--xy-color-text);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.post-images {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.single-image-grid {
  grid-template-columns: 1fr;
}

.two-image-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.three-image-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.post-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.single-image-grid .post-image {
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
}

.actions {
  justify-content: flex-end;
  padding: 0 36rpx 28rpx;
}

.action-button {
  padding: 0 28rpx;
  border: 1rpx solid var(--xy-color-border);
  background: var(--xy-color-background);
  color: var(--xy-color-heading);
  font-weight: 500;
  line-height: 56rpx;
}

.action-button[disabled] {
  opacity: 0.48;
}

.danger {
  color: #9f3a49;
}

.retry-button::after,
.text-link::after,
.action-button::after {
  border: 0;
}
