.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.hero-shell {
  position: relative;
  width: 100%;
  height: 858rpx;
  overflow: hidden;
  border-radius: 56rpx;
  background: var(--xy-gradient-cream);
}

.hero-swiper,
.hero-slide,
.hero-image,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-placeholder-label {
  max-width: 440rpx;
  padding: 0 34rpx;
  color: var(--xy-color-accent-text);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.7;
  text-align: center;
}

.hero-copy {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 58rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  pointer-events: none;
}

.hero-copy.on-image {
  padding-top: 120rpx;
  background: linear-gradient(180deg, rgba(15, 26, 38, 0) 0%, rgba(15, 26, 38, 0.22) 100%);
}

.title {
  color: var(--xy-color-heading);
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.12;
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.subtitle {
  margin-top: 8rpx;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.25;
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.hero-copy.on-image .title {
  color: #ffffff;
  text-shadow: 0 4rpx 18rpx rgba(27, 40, 55, 0.32);
}

.hero-copy.on-image .subtitle {
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 4rpx 18rpx rgba(27, 40, 55, 0.28);
}

.state {
  margin-top: 36rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.entry::after,
.cats-preview::after {
  border: 0;
}

.intro {
  display: flex;
  flex-direction: column;
  padding: 48rpx 20rpx 10rpx;
  text-align: center;
}

.eyebrow,
.group-en {
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.intro-text {
  margin-top: 30rpx;
  white-space: pre-line;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 2;
}

.star-divider,
.paw-trail {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 16rpx 0;
  color: rgba(180, 135, 37, 0.52);
}

.star-divider .line,
.paw-trail view {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent 0%, var(--xy-color-border) 50%, transparent 100%);
}

.star-cluster {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 232, 0.7);
  color: var(--xy-color-heading);
  font-size: 24rpx;
}

.star-cluster .moon {
  color: var(--xy-color-lilac);
  font-size: 27rpx;
}

.groups {
  margin-top: 44rpx;
}

.group {
  margin-top: 0;
  padding: 0 16rpx;
}

.group + .group {
  margin-top: 64rpx;
}

.group-head {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.group-head.reverse {
  flex-direction: row-reverse;
  text-align: right;
}

.group-copy {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.group-lead {
  display: block;
  margin-top: 14rpx;
  max-width: 470rpx;
  white-space: pre-line;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.85;
}

.reverse .group-lead {
  margin-left: auto;
}

.group-art {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(170, 180, 231, 0.72);
}

.cat-art image {
  width: 116rpx;
  height: 116rpx;
  opacity: 0.38;
  mix-blend-mode: multiply;
}

.path-art text {
  color: rgba(170, 180, 231, 0.72);
  font-size: 106rpx;
  line-height: 1;
}

.entry-list {
  margin-top: 22rpx;
  padding-left: 4rpx;
}

.entry {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  width: 100%;
  padding: 26rpx 0;
  background: transparent;
  text-align: left;
}

.entry.bordered {
  border-top: 1rpx dashed rgba(233, 221, 191, 0.9);
}

.entry-no {
  color: rgba(180, 135, 37, 0.72);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.3;
}

.entry-main {
  min-width: 0;
  flex: 1;
}

.entry-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.entry-title {
  color: var(--xy-color-heading);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.entry-status {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(249, 240, 212, 0.72);
  color: #9b7927;
  font-size: 20rpx;
  font-weight: 700;
}

.entry-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.8;
}

.entry-arrow {
  color: var(--xy-color-secondary);
  font-size: 34rpx;
  line-height: 1.2;
}

.paw-trail {
  margin: 34rpx 10rpx 56rpx;
  font-size: 16rpx;
}

.paw-trail .low {
  transform: translateY(8rpx);
}

.cats-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  width: calc(100% - 32rpx);
  margin: 88rpx 16rpx 0;
  padding: 46rpx 42rpx;
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 56rpx;
  background: var(--xy-gradient-cream);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.cats-art {
  position: absolute;
  right: -20rpx;
  bottom: -18rpx;
  width: 190rpx;
  height: 190rpx;
  opacity: 0.24;
  mix-blend-mode: multiply;
}

.cats-title {
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.cats-desc {
  max-width: 470rpx;
  margin-top: 22rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.9;
}

.cats-link {
  margin-top: 22rpx;
  color: var(--xy-color-violet);
  font-size: 26rpx;
  font-weight: 700;
}
