.page {
  min-height: 100vh;
  padding: 52rpx 0 calc(148rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.hero-shell {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  border-radius: 0;
  background: var(--xy-color-background);
}

.hero-shell.has-image {
  background: var(--xy-gradient-cream);
}

.hero-swiper,
.hero-slide,
.hero-image,
.hero-placeholder {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  background: var(--xy-color-background);
}

.hero-placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transform: translateY(40rpx);
}

.hero-placeholder .xy-placeholder-cat {
  width: 250rpx;
  height: 250rpx;
  opacity: 0.7;
}

.hero-indicator {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transform: translateX(-50%);
}

.hero-indicator-dot {
  display: block;
  width: 12rpx !important;
  height: 12rpx;
  min-width: 0;
  margin: 0 !important;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.8);
  line-height: 1;
}

.hero-indicator-dot.active {
  width: 40rpx !important;
  background: var(--xy-color-accent);
}

.hero-placeholder-label {
  max-width: 440rpx;
  padding: 0 34rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.7;
  text-align: center;
}

.hero-copy {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 58rpx;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  pointer-events: none;
}

.hero-copy.on-image {
  background: transparent;
}

.title {
  color: var(--xy-color-heading);
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1;
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.subtitle {
  margin-top: 8rpx;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 25rpx;
  font-style: italic;
  line-height: 1.15;
  transform: scaleX(0.93);
  transform-origin: center center;
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.hero-copy.on-image .title {
  color: var(--xy-color-heading);
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.hero-copy.on-image .subtitle {
  color: var(--xy-color-secondary);
  text-shadow: 0 3rpx 12rpx rgba(255, 253, 248, 0.72);
}

.state {
  margin-top: 36rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.entry::after,
.cats-preview::after,
.hero-indicator-dot::after {
  border: 0;
}

.intro {
  display: flex;
  flex-direction: column;
  margin: 0 36rpx;
  padding: 56rpx 0 10rpx;
  text-align: center;
}

.eyebrow,
.group-en {
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.intro-text {
  margin-top: 30rpx;
  white-space: pre-line;
  color: #6f7d8e;
  font-size: 26rpx;
  line-height: 2;
}

.intro .eyebrow {
  font-size: 22rpx;
  letter-spacing: 6rpx;
  line-height: 1.1;
}

.group-en {
  letter-spacing: 7rpx;
}

.star-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 40rpx 36rpx 0;
  color: rgba(180, 135, 37, 0.52);
}

.star-divider .line {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent 0%, var(--xy-color-border) 50%, transparent 100%);
}

.star-cluster {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 248, 232, 0.7);
  color: var(--xy-color-heading);
  font-size: 24rpx;
}

.star-icon {
  width: 24rpx;
  height: 24rpx;
}

.moon-icon {
  width: 28rpx;
  height: 28rpx;
}

.groups {
  margin: 44rpx 36rpx 0;
}

.group {
  margin-top: 0;
  padding: 0;
}

.group + .group {
  margin-top: 48rpx;
}

.group-head {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.group-head.reverse {
  flex-direction: row-reverse;
  text-align: right;
}

.group-copy {
  flex: 1;
  min-width: 0;
}

.group-title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.group-lead {
  display: block;
  margin-top: 14rpx;
  max-width: 470rpx;
  white-space: pre-line;
  color: #6f7d8e;
  font-size: 26rpx;
  line-height: 1.85;
}

.reverse .group-lead {
  margin-left: auto;
}

.group-art {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(170, 180, 231, 0.72);
}

.group-art-image {
  width: 128rpx;
  height: 128rpx;
}

.entry-list {
  margin-top: 40rpx;
  padding-left: 4rpx;
}

.entry {
  display: flex;
  align-items: flex-start;
  gap: 26rpx;
  width: 100% !important;
  max-width: 100%;
  box-sizing: border-box;
  margin-left: 0;
  margin-right: 0;
  padding: 28rpx 0;
  background: transparent;
  text-align: left;
  line-height: normal;
}

.entry.bordered {
  border-top: 1rpx dashed rgba(233, 221, 191, 0.9);
}

.entry-no {
  color: rgba(134, 166, 210, 0.72);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 26rpx;
  font-style: italic;
  line-height: 1.3;
}

.entry-main {
  min-width: 0;
  flex: 1;
}

.entry-title-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.entry-title {
  color: var(--xy-color-heading);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
}

.entry-status {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(249, 240, 212, 0.72);
  color: #9b7927;
  font-size: 20rpx;
  font-weight: 700;
}

.entry-desc {
  display: block;
  margin-top: 8rpx;
  color: #6f7d8e;
  font-size: 25rpx;
  line-height: 1.8;
}

.entry-arrow {
  color: var(--xy-color-secondary);
  font-size: 34rpx;
  line-height: 1.2;
}

.paw-trail {
  margin: 34rpx 0 56rpx;
}

.paw-trail-image {
  width: 100%;
}

.cats-preview {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: calc(100% - 72rpx) !important;
  max-width: 100%;
  margin: 122rpx 36rpx 0;
  padding: 56rpx 44rpx 58rpx;
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-gradient-cream);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.cats-art {
  position: absolute;
  right: -20rpx;
  bottom: -18rpx;
  width: 190rpx;
  height: 190rpx;
  opacity: 0.56;
}

.cats-title {
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.cats-desc {
  max-width: 470rpx;
  margin-top: 22rpx;
  color: #6f7d8e;
  font-size: 25rpx;
  line-height: 1.9;
}

.cats-link {
  margin-top: 22rpx;
  color: var(--xy-color-violet);
  font-size: 26rpx;
  font-weight: 700;
}
