<view class="page">
  <view class="hero">
    <view class="hero-art">
      <text class="moon">☾</text>
      <text class="star">✦</text>
    </view>
    <view class="hero-copy">
      <text class="title">{{title}}</text>
      <text class="subtitle">{{subtitle}}</text>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="state">正在加载首页内容...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>

  <view wx:else>
    <view class="intro">
      <text class="eyebrow">{{introMeta}}</text>
      <text class="intro-text">{{introBody}}</text>
    </view>

    <view class="divider">
      <view></view>
      <text>✦</text>
      <view></view>
    </view>

    <view wx:for="{{groups}}" wx:key="cn" class="group">
      <text class="group-en">{{item.en}}</text>
      <text class="group-title">{{item.cn}}</text>
      <text class="group-lead">{{item.lead}}</text>
      <view class="entry-list">
        <button
          wx:for="{{item.entries}}"
          wx:for-item="entry"
          wx:key="no"
          class="entry"
          data-url="{{entry.url}}"
          bindtap="openEntry"
        >
          <text class="entry-no">{{entry.no}}</text>
          <view class="entry-main">
            <text class="entry-title">{{entry.title}}</text>
            <text class="entry-desc">{{entry.desc}}</text>
          </view>
          <text class="entry-arrow">›</text>
        </button>
      </view>
    </view>

    <button class="cats-preview" bindtap="openCats">
      <text class="eyebrow">Our Cats</text>
      <text class="cats-title">{{catsPreview.title}}</text>
      <text class="cats-desc">{{catsPreview.description}}</text>
      <text class="cats-link">查看小猫与种猫 ›</text>
    </button>
  </view>
</view>
