<view class="page">
  <view wx:if="{{isLoading}}" class="state">正在加载动态...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>

  <view wx:else class="post">
    <view class="post-head">
      <view>
        <view class="author-row">
          <text class="author">{{author}}</text>
          <text wx:if="{{pinned}}" class="pin">置顶</text>
        </view>
        <text class="date">{{date}}</text>
      </view>
      <text class="category">{{category}}</text>
    </view>

    <text class="content">{{content}}</text>

    <view wx:if="{{images.length}}" class="gallery">
      <image
        wx:for="{{images}}"
        wx:key="id"
        class="gallery-image"
        src="{{item.url}}"
        mode="aspectFill"
        data-url="{{item.url}}"
        bindtap="previewImage"
      />
    </view>

    <view wx:if="{{linkedLitters.length || linkedCats.length}}" class="links">
      <text class="links-title">关联信息</text>
      <view wx:if="{{linkedCats.length}}" class="link-group">
        <text wx:for="{{linkedCats}}" wx:key="*this" class="link-pill">猫咪：{{item}}</text>
      </view>
      <view wx:if="{{linkedLitters.length}}" class="link-group">
        <text wx:for="{{linkedLitters}}" wx:key="*this" class="link-pill litter">窝次：{{item}}</text>
      </view>
    </view>

    <view class="meta-row">
      <button class="{{likedByMe ? 'like-button liked' : 'like-button'}}" bindtap="toggleLike">
        <image
          class="like-icon"
          src="{{likedByMe ? '../../assets/illustrations/paw-like-active.png' : '../../assets/illustrations/paw-like.png'}}"
          mode="aspectFit"
        />
      </button>
      <text class="meta-text">{{meta}}</text>
    </view>

    <view wx:if="{{canEdit || canDelete}}" class="action-row">
      <button wx:if="{{canEdit}}" class="secondary-button" bindtap="openEdit">编辑</button>
      <button wx:if="{{canDelete}}" class="danger-button" bindtap="deletePost">删除</button>
    </view>

    <view class="comments">
      <text class="comments-title">评论</text>
      <view wx:if="{{!comments.length}}" class="empty-comments">还没有评论</view>
      <view wx:for="{{comments}}" wx:key="id" class="comment-row">
        <view class="comment-main">
          <text class="comment-author">{{item.author}}</text>
          <text class="comment-content">{{item.content}}</text>
          <text class="comment-date">{{item.date}}</text>
        </view>
        <button
          wx:if="{{item.canDelete}}"
          class="comment-delete"
          data-id="{{item.id}}"
          bindtap="deleteComment"
        >
          删除
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{!isLoading && !error}}" class="comment-form">
    <input
      class="comment-input"
      placeholder="留下你的评论…"
      value="{{commentText}}"
      bindinput="onCommentInput"
    />
    <button class="comment-submit" bindtap="submitComment">发送</button>
  </view>
</view>
