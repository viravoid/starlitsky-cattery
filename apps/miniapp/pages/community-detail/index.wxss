.page {
  min-height: 100vh;
  padding: 30rpx 24rpx calc(88rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 120rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.like-button::after,
.secondary-button::after,
.danger-button::after,
.comment-delete::after,
.comment-submit::after {
  border: 0;
}

.post {
  padding: 26rpx 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
}

.post-head,
.tag-row,
.links,
.link-group,
.meta-row,
.action-row,
.comment-row,
.comment-form {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author,
.date,
.content,
.link-label,
.meta-row text {
  display: block;
}

.author {
  color: #41546c;
  font-size: 30rpx;
  font-weight: 700;
}

.date {
  margin-top: 6rpx;
  color: var(--xy-color-muted);
  font-size: 22rpx;
}

.tag-row {
  flex-shrink: 0;
  gap: 8rpx;
}

.pin,
.category,
.link-pill {
  border-radius: 999rpx;
  font-weight: 700;
}

.pin,
.category {
  padding: 4rpx 14rpx;
  font-size: 21rpx;
}

.pin {
  background: #f6dfc5;
  color: #9a5b28;
}

.category {
  background: #e9f1f8;
  color: #55799f;
}

.content {
  margin-top: 28rpx;
  color: var(--xy-color-text);
  font-size: 29rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.gallery-image {
  width: 100%;
  height: 260rpx;
  border-radius: 20rpx;
  background: #f6ecd3;
}

.links {
  flex-direction: column;
  gap: 18rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--xy-color-border);
}

.link-group {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.link-label {
  width: 128rpx;
  color: var(--xy-color-muted);
  font-size: 23rpx;
}

.link-pill {
  max-width: 460rpx;
  padding: 6rpx 16rpx;
  background: #f9f0d4;
  color: #9a7424;
  font-size: 23rpx;
}

.meta-row {
  justify-content: flex-end;
  margin-top: 24rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.action-row {
  align-items: center;
  gap: 12rpx;
  margin-top: 22rpx;
}

.like-button,
.secondary-button,
.danger-button,
.comment-delete,
.comment-submit {
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.like-button {
  min-width: 132rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  color: #6b8db3;
  line-height: 62rpx;
}

.like-button.liked {
  border-color: #e4b4b4;
  background: #fff0f0;
  color: #b42318;
}

.secondary-button,
.danger-button {
  min-width: 112rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  line-height: 62rpx;
}

.secondary-button {
  color: #55799f;
}

.danger-button {
  color: #b42318;
}

.comments {
  margin-top: 32rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid var(--xy-color-border);
}

.comments-title {
  display: block;
  margin-bottom: 18rpx;
  color: #41546c;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-comments {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #fffaf1;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  text-align: center;
}

.comment-row {
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--xy-color-border);
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-author,
.comment-content,
.comment-date {
  display: block;
}

.comment-author {
  color: #41546c;
  font-size: 24rpx;
  font-weight: 700;
}

.comment-content {
  margin-top: 6rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.comment-date {
  margin-top: 6rpx;
  color: var(--xy-color-muted);
  font-size: 21rpx;
}

.comment-delete {
  flex-shrink: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  color: #b42318;
  line-height: 52rpx;
}

.comment-form {
  gap: 12rpx;
  margin-top: 22rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: #ffffff;
  color: var(--xy-color-text);
  font-size: 25rpx;
}

.comment-submit {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 0 22rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  line-height: 68rpx;
}
