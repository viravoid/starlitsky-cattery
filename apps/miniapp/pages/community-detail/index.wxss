.page {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(164rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 120rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.like-button::after,
.secondary-button::after,
.danger-button::after,
.comment-delete::after,
.comment-action::after,
.comment-submit::after {
  border: 0;
}

.post {
  padding: 0 0 48rpx;
}

.post-head,
.author-row,
.links,
.link-group,
.post-foot,
.comment-meta-row,
.action-row,
.comment-row,
.comment-form {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author-block {
  min-width: 0;
}

.author-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.author,
.date,
.content,
.meta-text {
  display: block;
}

.author {
  max-width: 390rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.role-pill,
.pin,
.category-dot,
.link-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.role-pill {
  padding: 4rpx 14rpx;
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.role-pill.keeper {
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.pin {
  padding: 4rpx 12rpx;
  background: #fff1c9;
  color: #7a9ac0;
}

.category-dot {
  flex-shrink: 0;
  color: #6f93bc;
  font-weight: 700;
}

.content {
  margin-top: 28rpx;
  color: var(--xy-color-text);
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.gallery {
  display: grid;
  gap: 10rpx;
  margin-top: 24rpx;
}

.single-image-grid {
  grid-template-columns: 1fr;
}

.two-image-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.three-image-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.gallery-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.single-image-grid .gallery-image {
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
}

.links {
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.links-title {
  color: rgba(180, 135, 37, 0.82);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.link-group {
  flex-wrap: wrap;
  gap: 10rpx;
}

.litter-group {
  margin-bottom: 2rpx;
}

.link-pill {
  max-width: 100%;
  padding: 8rpx 18rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--xy-color-heading);
}

.link-pill.litter {
  border: 1rpx solid #eedb9b;
  background: #fff7dd;
  color: #6f93bc;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.cat-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 92rpx;
}

.cat-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 128rpx;
  height: 128rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.82);
  border-radius: 999rpx;
  background: var(--xy-gradient-cream);
}

.cat-avatar-icon {
  width: 68rpx;
  height: 68rpx;
}

.cat-link-name {
  max-width: 132rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-foot {
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(233, 221, 191, 0.72);
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.like-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: auto !important;
  min-width: 0;
  height: 48rpx;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx;
  background: transparent;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.like-button.liked {
  color: #6f93bc;
}

.like-icon {
  width: 32rpx;
  height: 32rpx;
}

.comment-action {
  width: auto !important;
  min-width: 0;
  height: 48rpx;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.action-row {
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 22rpx;
}

.secondary-button,
.danger-button,
.comment-delete,
.comment-submit {
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.secondary-button,
.danger-button {
  width: auto !important;
  min-width: 0;
  margin: 0 !important;
  padding: 0 18rpx !important;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  line-height: 52rpx;
}

.secondary-button {
  color: #55799f;
}

.danger-button {
  color: #b42318;
}

.comments {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--xy-color-border);
}

.comments-title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--xy-color-secondary);
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.empty-comments {
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-muted);
  font-size: 24rpx;
  text-align: center;
}

.comment-row {
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--xy-color-border);
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-meta-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.comment-author,
.comment-content,
.comment-date {
  display: block;
}

.comment-author {
  color: var(--xy-color-heading);
  font-size: 25rpx;
  font-weight: 700;
}

.comment-content {
  margin-top: 6rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.comment-date {
  margin-top: 6rpx;
  color: var(--xy-color-muted);
  font-size: 21rpx;
}

.comment-delete {
  flex-shrink: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  color: #b42318;
  line-height: 52rpx;
}

.comment-form {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  gap: 12rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--xy-color-border);
  background: var(--xy-color-surface);
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-text);
  font-size: 26rpx;
}

.comment-submit {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 0 22rpx;
  background: #839ac0;
  color: #ffffff;
  line-height: 76rpx;
}
