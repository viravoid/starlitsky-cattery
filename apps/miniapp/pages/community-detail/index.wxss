.page {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(164rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 120rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.like-button::after,
.secondary-button::after,
.danger-button::after,
.comment-delete::after,
.comment-submit::after {
  border: 0;
}

.post {
  padding: 0 0 48rpx;
}

.post-head,
.author-row,
.links,
.link-group,
.meta-row,
.action-row,
.comment-row,
.comment-form {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.author,
.date,
.content,
.meta-text {
  display: block;
}

.author {
  max-width: 390rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 28rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.pin,
.category,
.link-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.pin {
  padding: 4rpx 12rpx;
  background: #fff0c4;
  color: var(--xy-color-accent-text);
}

.category {
  flex-shrink: 0;
  color: rgba(180, 135, 37, 0.82);
}

.content {
  margin-top: 28rpx;
  color: var(--xy-color-text);
  font-size: 29rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 24rpx;
}

.gallery-image {
  width: 100%;
  height: 212rpx;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.gallery-image:first-child:nth-last-child(1) {
  grid-column: span 3;
  height: 430rpx;
  border-radius: 32rpx;
}

.links {
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.links-title {
  color: rgba(180, 135, 37, 0.82);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.link-group {
  flex-wrap: wrap;
  gap: 10rpx;
}

.link-pill {
  max-width: 100%;
  padding: 8rpx 18rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--xy-color-heading);
}

.link-pill.litter {
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.meta-row {
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.like-button {
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 999rpx;
  background: transparent;
  color: var(--xy-color-secondary);
  font-size: 34rpx;
  line-height: 52rpx;
}

.like-button.liked {
  color: var(--xy-color-violet);
}

.like-icon {
  width: 34rpx;
  height: 34rpx;
}

.action-row {
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 22rpx;
}

.secondary-button,
.danger-button,
.comment-delete,
.comment-submit {
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.secondary-button,
.danger-button {
  min-width: 112rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  line-height: 62rpx;
}

.secondary-button {
  color: #55799f;
}

.danger-button {
  color: #b42318;
}

.comments {
  margin-top: 48rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--xy-color-border);
}

.comments-title {
  display: block;
  margin-bottom: 18rpx;
  color: var(--xy-color-heading);
  font-size: 28rpx;
  font-weight: 700;
}

.empty-comments {
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-muted);
  font-size: 24rpx;
  text-align: center;
}

.comment-row {
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--xy-color-border);
}

.comment-main {
  flex: 1;
  min-width: 0;
}

.comment-author,
.comment-content,
.comment-date {
  display: block;
}

.comment-author {
  color: var(--xy-color-heading);
  font-size: 24rpx;
  font-weight: 700;
}

.comment-content {
  margin-top: 6rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.comment-date {
  margin-top: 6rpx;
  color: var(--xy-color-muted);
  font-size: 21rpx;
}

.comment-delete {
  flex-shrink: 0;
  padding: 0 18rpx;
  border: 1rpx solid var(--xy-color-border);
  background: #ffffff;
  color: #b42318;
  line-height: 52rpx;
}

.comment-form {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  gap: 12rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.comment-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-text);
  font-size: 26rpx;
}

.comment-submit {
  flex-shrink: 0;
  min-width: 112rpx;
  padding: 0 22rpx;
  background: var(--xy-color-violet);
  color: #ffffff;
  line-height: 76rpx;
}
