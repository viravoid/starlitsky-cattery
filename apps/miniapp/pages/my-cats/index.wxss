.page {
  min-height: 100vh;
  padding: 30rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 16rpx 24rpx;
}

.eyebrow {
  display: block;
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.state {
  padding: 96rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.auth-art {
  width: 132rpx;
  height: 132rpx;
  opacity: 0.38;
}

.auth-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.retry-button,
.auth-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.retry-button::after,
.auth-button::after,
.cat-card::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cat-card {
  display: flex;
  min-height: 232rpx;
  gap: 22rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 44rpx;
  background: var(--xy-color-surface);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.thumb {
  flex-shrink: 0;
  width: 190rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 34rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  width: 100%;
  height: 100%;
}

.thumb-empty .xy-placeholder-cat {
  width: 96rpx;
  height: 96rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.relationship,
.name,
.meta,
.detail {
  display: block;
}

.relationship {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
  font-size: 21rpx;
  font-weight: 700;
}

.name {
  margin-top: 12rpx;
  color: var(--xy-color-heading);
  font-size: 32rpx;
  font-weight: 700;
}

.meta {
  margin-top: 7rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.detail {
  margin-top: 14rpx;
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}
