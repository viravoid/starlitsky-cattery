.page {
  min-height: 100vh;
  padding: 40rpx 40rpx calc(96rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 96rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.auth-art {
  width: 132rpx;
  height: 132rpx;
  opacity: 0.38;
}

.auth-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.retry-button,
.auth-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.retry-button::after,
.auth-button::after,
.cat-card::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.intro {
  display: block;
  color: var(--xy-color-secondary);
  font-size: 25rpx;
  line-height: 1.75;
  margin-bottom: 4rpx;
}

.cat-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 156rpx;
  padding: 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 36rpx;
  background: var(--xy-color-surface);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.thumb {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  width: 100%;
  height: 100%;
}

.thumb-empty .xy-placeholder-cat {
  width: 62rpx;
  height: 62rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.name-row,
.name,
.meta,
.detail {
  display: block;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-pill {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(212, 231, 242, 0.48);
  color: #6b8db3;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.gender-pill.female {
  background: rgba(255, 232, 166, 0.45);
  color: var(--xy-color-accent-text);
}

.meta {
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.detail {
  margin-top: 10rpx;
  color: var(--xy-color-primary);
  font-size: 23rpx;
  font-weight: 700;
}
