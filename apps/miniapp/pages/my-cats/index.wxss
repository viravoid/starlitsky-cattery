.page {
  min-height: 100vh;
  padding: 30rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 10rpx 24rpx;
}

.eyebrow {
  display: block;
  color: #b48725;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #41546c;
  font-size: 44rpx;
  font-weight: 700;
}

.state {
  padding: 96rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.auth-title {
  color: #41546c;
  font-size: 29rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.retry-button,
.auth-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.retry-button::after,
.auth-button::after,
.cat-card::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cat-card {
  display: flex;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
  text-align: left;
}

.thumb {
  flex-shrink: 0;
  width: 188rpx;
  height: 188rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f6ecd3;
}

.thumb image,
.thumb-empty {
  width: 100%;
  height: 100%;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b48725;
  font-size: 28rpx;
  font-weight: 700;
}

.info {
  flex: 1;
  min-width: 0;
}

.relationship,
.name,
.meta,
.detail {
  display: block;
}

.relationship {
  width: fit-content;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: #b48725;
  font-size: 21rpx;
  font-weight: 700;
}

.name {
  margin-top: 10rpx;
  color: #41546c;
  font-size: 32rpx;
  font-weight: 700;
}

.meta {
  margin-top: 6rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.detail {
  margin-top: 12rpx;
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}
