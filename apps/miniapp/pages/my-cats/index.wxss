.page {
  min-height: 100vh;
  padding: 58rpx 40rpx calc(96rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  display: flex;
  flex-direction: column;
  margin-bottom: 30rpx;
}

.eyebrow {
  display: block;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  line-height: 1.35;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.header-copy {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.75;
}

.state {
  padding: 96rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 72rpx;
  padding: 56rpx 36rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.auth-art {
  width: 156rpx;
  height: 156rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(231, 193, 93, 0.28);
  border-radius: 999rpx;
  background: #fff4d6;
  opacity: 1;
}

.auth-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.retry-button,
.auth-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  min-height: 76rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.retry-button::after,
.auth-button::after,
.cat-main::after,
.card-action::after,
.add-card::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.intro {
  display: block;
  color: var(--xy-color-secondary);
  font-size: 25rpx;
  line-height: 1.75;
  margin-bottom: 4rpx;
}

.add-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  border: 1rpx solid rgba(231, 193, 93, 0.5);
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--xy-color-accent) 0%, #d9a83e 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(180, 135, 37, 0.18);
  text-align: left;
}

.add-card-label {
  display: block;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.add-card-copy {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 1.55;
}

.cat-card {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.cat-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 116rpx;
  padding: 0;
  background: transparent;
  text-align: left;
}

.thumb {
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  width: 100%;
  height: 100%;
}

.thumb-empty .xy-placeholder-cat {
  width: 62rpx;
  height: 62rpx;
}

.info {
  flex: 1;
  min-width: 0;
}

.name-row,
.name,
.meta,
.detail {
  display: block;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gender-pill {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(212, 231, 242, 0.48);
  color: #6b8db3;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.gender-pill.female {
  background: rgba(255, 232, 166, 0.45);
  color: var(--xy-color-primary);
}

.meta {
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.5;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
  padding-left: 136rpx;
}

.card-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 8rpx 18rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.78);
  color: var(--xy-color-muted);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-action.primary {
  border-color: var(--xy-color-accent);
  background: var(--xy-color-accent);
  color: #ffffff;
}

.card-action.danger {
  border-color: rgba(196, 106, 106, 0.2);
  background: rgba(255, 253, 248, 0.52);
  color: #b35d5d;
}
