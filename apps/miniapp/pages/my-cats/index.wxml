<view class="page">
  <view wx:if="{{isLoading}}" class="state">正在加载我的猫咪...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{needsParentAuth}}" class="state auth-state">
    <image class="auth-art" src="../../assets/placeholder-cat.png" mode="aspectFit" />
    <text class="auth-title">尚未完成家长认证</text>
    <text class="auth-copy">完成家长认证后，可以在这里查看自己的猫咪资料和时光轴。</text>
    <button class="auth-button" bindtap="openParentAuth">去家长认证</button>
  </view>
  <view wx:elif="{{isEmpty}}" class="state auth-state">
    <image class="auth-art" src="../../assets/placeholder-cat.png" mode="aspectFit" />
    <text class="auth-title">暂时没有已关联猫咪</text>
    <text class="auth-copy">可以先添加自家猫咪，之后在发布动态时关联它。</text>
    <button class="auth-button" bindtap="openNewCat">添加猫咪</button>
  </view>

  <view wx:else class="list">
    <text class="intro">添加你的猫咪，可以在发布动态时关联它，也能生成一条专属的成长时光轴。</text>
    <button class="add-card" bindtap="openNewCat">+ 添加猫咪</button>
    <view wx:for="{{items}}" wx:key="id" class="cat-card">
      <button class="cat-main" data-id="{{item.id}}" bindtap="openCat">
        <view class="thumb">
          <image wx:if="{{item.imageUrl}}" class="thumb-image" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="thumb-empty xy-soft-placeholder">
            <image class="xy-placeholder-cat" src="../../assets/placeholder-cat.png" mode="aspectFit" />
          </view>
        </view>
        <view class="info">
          <view class="name-row">
            <text class="name">{{item.name}}</text>
            <text class="{{item.genderClass}}">{{item.gender}}</text>
          </view>
          <text class="meta">{{item.color}}</text>
          <text class="meta">{{item.litterName}} · {{item.status}}</text>
        </view>
      </button>
      <view class="action-row">
        <button class="card-action" data-id="{{item.id}}" catchtap="openCatEdit">编辑</button>
        <button class="card-action primary" data-id="{{item.id}}" catchtap="openCat">查看时光轴</button>
        <button class="card-action danger" data-id="{{item.id}}" catchtap="deleteCat">删除</button>
      </view>
    </view>
  </view>
</view>
