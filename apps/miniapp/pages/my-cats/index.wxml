<view class="page">
  <view class="header">
    <text class="eyebrow">My Cats</text>
    <text class="title">我的猫咪</text>
  </view>

  <view wx:if="{{isLoading}}" class="state">正在加载我的猫咪...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{needsParentAuth}}" class="state auth-state">
    <text class="auth-title">尚未完成家长认证或没有已关联猫咪</text>
    <text class="auth-copy">完成家长认证后，可以在这里查看自己的猫咪资料和时光轴。</text>
    <button class="auth-button" bindtap="openParentAuth">去家长认证</button>
  </view>

  <view wx:else class="list">
    <button wx:for="{{items}}" wx:key="id" class="cat-card" data-id="{{item.id}}" bindtap="openCat">
      <view class="thumb">
        <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" />
        <view wx:else class="thumb-empty">星月</view>
      </view>
      <view class="info">
        <text class="relationship">{{item.relationship}}</text>
        <text class="name">{{item.name}}</text>
        <text class="meta">{{item.lineOne}}</text>
        <text class="meta">{{item.lineTwo}}</text>
        <text class="detail">查看时光轴 ›</text>
      </view>
    </button>
  </view>
</view>
