.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(166rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 120rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.header {
  display: none;
}

.title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 42rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.retry-button,
.submit-button {
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  line-height: 72rpx;
}

.retry-button::after,
.option::after,
.add-image::after,
.remove-image::after,
.restore-image::after,
.submit-button::after {
  border: 0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section {
  padding: 0;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--xy-color-heading);
  font-size: 26rpx;
  font-weight: 700;
}

.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-height: 62rpx;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.option.active {
  border-color: #eedb9b;
  background: #fff7dd;
  color: #6f93bc;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 1.65;
}

.empty-box {
  padding: 30rpx;
  border-radius: 28rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-muted);
  font-size: 24rpx;
  text-align: center;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.image-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--xy-color-muted);
  font-size: 22rpx;
}

.image-wrap {
  position: relative;
}

.image-removed .image-tile {
  opacity: 0.34;
}

.image-tile,
.add-image {
  width: 100%;
  height: 208rpx;
  border-radius: 28rpx;
}

.image-tile {
  background: var(--xy-gradient-cream);
}

.add-image {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0 !important;
  border: 2rpx dashed var(--xy-color-border);
  background: var(--xy-color-surface);
  line-height: 208rpx;
}

.add-image-symbol {
  color: #6f93bc;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.remove-image {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx !important;
  min-width: 0;
  height: 42rpx;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 999rpx;
  background: rgba(65, 84, 108, 0.82);
  line-height: 42rpx;
}

.remove-image-icon {
  width: 24rpx;
  height: 24rpx;
}

.restore-image {
  position: absolute;
  left: 50%;
  top: 50%;
  width: auto !important;
  min-width: 86rpx;
  height: 46rpx;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0 18rpx !important;
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.94);
  color: #6f93bc;
  font-size: 24rpx;
  line-height: 46rpx;
  transform: translate(-50%, -50%);
}

.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.notice {
  padding: 20rpx 24rpx;
  border: 1rpx solid #eedb9b;
  border-radius: 28rpx;
  background: rgba(255, 247, 221, 0.58);
  color: #6b8db3;
  font-size: 22rpx;
  line-height: 1.7;
}

.notice-pill {
  display: inline-flex;
  margin-bottom: 8rpx;
  padding: 4rpx 14rpx;
  border: 1rpx solid #eedb9b;
  border-radius: 999rpx;
  background: #fff7dd;
  color: #6f93bc;
  font-weight: 700;
}

.notice-text {
  display: block;
}

.submit-button {
  width: 100%;
  line-height: 88rpx;
}

.submit-button[disabled] {
  background: #c6cbd2;
  color: rgba(255, 255, 255, 0.82);
}
