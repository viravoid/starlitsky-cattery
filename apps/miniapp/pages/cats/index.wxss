.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(236rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 0 18rpx;
}

.eyebrow {
  display: block;
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sticky-controls {
  position: sticky;
  top: 0;
  z-index: 2;
  padding-top: 16rpx;
  background: rgba(255, 250, 241, 0.96);
  backdrop-filter: blur(20rpx);
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-bottom: 1rpx solid rgba(233, 221, 191, 0.86);
}

.tab {
  position: relative;
  padding: 20rpx 0;
  background: transparent;
  color: var(--xy-color-muted);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.tab.active {
  color: var(--xy-color-primary);
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  transform: translateX(-50%);
}

.filters-scroll,
.litter-filters-scroll {
  width: 100%;
  margin: 20rpx 0 0;
  overflow: hidden;
  white-space: nowrap;
}

.filters-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
}

.litter-filters {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  width: max-content;
  min-width: 100%;
  margin-top: 16rpx;
  padding-bottom: 10rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.active-filter {
  border-color: var(--xy-color-accent);
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.state {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.tab::after,
.filter::after,
.cat-row::after,
.retry-button::after,
.questionnaire-button::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cat-row {
  display: flex;
  min-height: 256rpx;
  gap: 22rpx;
  width: 100%;
  margin: 0;
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 44rpx;
  background: var(--xy-color-surface);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.thumb {
  width: 32%;
  flex: 0 0 32%;
  min-width: 208rpx;
  align-self: stretch;
  overflow: hidden;
  border-radius: 34rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  width: 100%;
  height: 100%;
  min-height: 216rpx;
}

.thumb-empty .xy-placeholder-cat {
  width: 96rpx;
  height: 96rpx;
}

.info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 4rpx 4rpx 2rpx 0;
}

.pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.name {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-heading);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.meta {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--xy-color-text);
  font-size: 23rpx;
  line-height: 1.38;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail {
  align-self: flex-end;
  margin-top: auto;
  padding-top: 16rpx;
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.questionnaire-icon {
  position: absolute;
  left: calc(50% - 142rpx);
  top: 44rpx;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
}

.questionnaire-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}
