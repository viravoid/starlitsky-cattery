.page {
  min-height: 100vh;
  padding: 116rpx 40rpx calc(320rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 0 18rpx;
}

.eyebrow {
  display: block;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sticky-controls {
  position: sticky;
  top: 0;
  z-index: 2;
  padding-top: 16rpx;
  background: rgba(255, 250, 241, 0.96);
  backdrop-filter: blur(20rpx);
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-bottom: 1rpx solid rgba(233, 221, 191, 0.86);
}

.tab {
  position: relative;
  display: flex;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  justify-self: stretch;
  margin: 0 !important;
  padding: 20rpx 0 !important;
  background: transparent;
  color: var(--xy-color-muted);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.tab-label {
  display: block;
  line-height: 1.3;
}

.tab.active {
  color: var(--xy-color-primary);
}

.tab-line {
  position: absolute;
  left: 50%;
  bottom: -1rpx;
  width: 64rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  transform: translateX(-50%);
}

.filters-scroll,
.litter-filters-scroll {
  width: 100%;
  margin: 20rpx 0 0;
  overflow: hidden;
  white-space: nowrap;
}

.litter-filters-scroll {
  height: 92rpx;
  margin-top: 16rpx;
}

.filters-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
}

.litter-filters {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  width: max-content;
  min-width: 100%;
  margin-top: 16rpx;
  padding-bottom: 10rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.litter-toggle {
  gap: 8rpx;
}

.litter-chevron {
  display: inline-block;
  color: inherit;
  font-size: 20rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.litter-chevron.open {
  transform: rotate(180deg) translateY(1rpx);
}

.active-filter {
  border-color: var(--xy-color-accent);
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
}

.state {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.tab::after,
.filter::after,
.cat-row::after,
.retry-button::after,
.questionnaire-button::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}

.list-expanded {
  margin-top: 24rpx;
}

.cat-row {
  display: block;
  width: 100% !important;
  max-width: 100%;
  min-height: 0;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 28rpx 32rpx 30rpx;
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  text-align: left;
  line-height: normal;
  box-shadow: var(--xy-shadow-card);
}

.card-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.thumb {
  position: relative;
  width: 100%;
  height: 348rpx;
  min-width: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.manual-crop-image {
  position: absolute;
  max-width: none;
  min-height: 0;
}

.thumb-empty .xy-placeholder-cat {
  width: 96rpx;
  height: 96rpx;
}

.info {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 0;
}

.pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: var(--xy-color-accent-text);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.name {
  display: block;
  margin-top: 24rpx;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 28rpx;
  row-gap: 10rpx;
  margin-top: 30rpx;
}

.meta-item {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 10rpx;
}

.meta-label,
.meta-value {
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-label {
  flex-shrink: 0;
  color: var(--xy-color-muted);
}

.meta-value {
  min-width: 0;
  color: var(--xy-color-text);
}

.detail {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  margin-top: 24rpx;
  border: 2rpx solid var(--xy-color-primary);
  border-radius: 999rpx;
  color: var(--xy-color-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 45;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.questionnaire-icon {
  position: absolute;
  left: calc(50% - 142rpx);
  top: 44rpx;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  pointer-events: none;
}

.questionnaire-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  box-sizing: border-box;
  margin: 0 !important;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 96rpx;
}
