.page {
  min-height: 100vh;
  padding: 30rpx 24rpx calc(148rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 10rpx 18rpx;
}

.eyebrow {
  display: block;
  color: #b48725;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: #41546c;
  font-size: 44rpx;
  font-weight: 700;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  border-bottom: 1rpx solid rgba(233, 221, 191, 0.9);
  background: rgba(255, 250, 241, 0.96);
}

.tab {
  padding: 20rpx 0;
  background: transparent;
  color: var(--xy-color-muted);
  font-size: 30rpx;
  font-weight: 600;
}

.tab::after,
.filter::after,
.cat-row::after {
  border: 0;
}

.tab.active {
  color: var(--xy-color-primary);
}

.filters {
  width: 100%;
  margin: 20rpx 0 16rpx;
  white-space: nowrap;
}

.filter {
  display: inline-flex;
  margin-right: 14rpx;
  padding: 10rpx 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 600;
}

.active-filter {
  border-color: var(--xy-color-accent);
  background: #f9f0d4;
  color: #b48725;
}

.state {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.cat-row {
  display: flex;
  min-height: 232rpx;
  gap: 20rpx;
  width: 100%;
  padding: 16rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
  text-align: left;
}

.thumb {
  width: 32%;
  min-width: 206rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f6ecd3;
}

.thumb image,
.thumb-empty {
  width: 100%;
  height: 100%;
  min-height: 200rpx;
}

.thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(122, 154, 192, 0.72);
  font-size: 28rpx;
  font-weight: 700;
}

.info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  padding: 4rpx 4rpx 2rpx 0;
}

.pill {
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: #b48725;
  font-size: 21rpx;
  font-weight: 700;
}

.name {
  display: block;
  margin-top: 14rpx;
  color: #41546c;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.28;
}

.meta {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--xy-color-text);
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail {
  align-self: flex-end;
  margin-top: auto;
  padding-top: 14rpx;
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}
