.page {
  min-height: 100vh;
  padding: 116rpx 40rpx calc(320rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  padding: 8rpx 0 18rpx;
}

.eyebrow {
  display: block;
  color: var(--xy-color-secondary);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  line-height: 1.35;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sticky-controls {
  position: sticky;
  top: 0;
  z-index: 2;
  padding-top: 16rpx;
  background: rgba(255, 250, 241, 0.96);
  backdrop-filter: blur(20rpx);
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  border-bottom: 0;
}

.tab {
  position: relative;
  display: flex;
  width: auto !important;
  min-width: 0;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  justify-self: stretch;
  margin: 0 !important;
  padding: 18rpx 0 !important;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-muted);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.tab-label {
  display: block;
  line-height: 1.3;
}

.tab.active {
  border-color: var(--xy-color-accent);
  background: var(--xy-color-accent);
  color: #ffffff;
}

.tab-line {
  display: none;
}

.kitten-filter-entry {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.entry-button,
.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  box-sizing: border-box;
  margin: 0 !important;
  border: 1rpx solid rgba(126, 161, 194, 0.42);
  border-radius: 999rpx;
  color: #6b8db3;
  font-weight: 700;
  line-height: 1.25;
  white-space: nowrap;
}

.entry-button {
  width: 100% !important;
  min-height: 58rpx;
  padding: 10rpx 20rpx;
  gap: 8rpx;
  background: var(--xy-color-surface);
  color: #5f83ab;
  font-size: 25rpx;
}

.filter {
  flex-shrink: 0;
  width: auto !important;
  min-height: 54rpx;
  padding: 10rpx 24rpx;
  background: var(--xy-color-surface);
  font-size: 23rpx;
}

.filter-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 14rpx;
  padding: 18rpx 16rpx;
  border: 1rpx solid rgba(231, 193, 93, 0.32);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.92);
}

.filter-section {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  align-items: center;
  column-gap: 14rpx;
}

.filter-section-title {
  color: var(--xy-color-heading);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.filter-options {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.litter-row-scroll {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
}

.scroll-options {
  width: max-content;
  min-width: 100%;
  flex-wrap: nowrap;
  padding-bottom: 2rpx;
}

.stud-filter-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 14rpx;
}

.stud-filter-row .filter {
  width: 100% !important;
  min-height: 56rpx;
  padding-right: 8rpx;
  padding-left: 8rpx;
  font-size: 22rpx;
}

.litter-chevron {
  display: inline-block;
  color: inherit;
  font-size: 20rpx;
  line-height: 1;
  transform: translateY(-1rpx);
}

.litter-chevron.open {
  transform: rotate(180deg) translateY(1rpx);
}

.active-filter {
  border-color: #8fb0ce;
  background: #8fb0ce;
  color: #ffffff;
}

.state {
  padding: 96rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-top: 34rpx;
  padding: 56rpx 32rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.empty-art {
  width: 120rpx;
  height: 120rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(231, 193, 93, 0.28);
  border-radius: 999rpx;
  background: #fff4d6;
  opacity: 0.72;
}

.empty-title {
  color: var(--xy-color-heading);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.45;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.tab::after,
.filter::after,
.cat-row::after,
.retry-button::after,
.questionnaire-button::after {
  border: 0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}

.cat-row {
  position: relative;
  display: flex;
  gap: 24rpx;
  width: 100% !important;
  max-width: 100%;
  min-height: 292rpx;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  text-align: left;
  line-height: normal;
  box-shadow: var(--xy-shadow-card);
}

.card-pills {
  position: absolute;
  top: 18rpx;
  right: 20rpx;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-width: calc(100% - 300rpx);
  pointer-events: none;
}

.thumb {
  position: relative;
  width: 218rpx;
  min-width: 218rpx;
  height: 236rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: var(--xy-color-muted-surface);
}

.thumb-image,
.thumb-empty {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.positioned-image {
  position: absolute;
  max-width: none;
  min-height: 0;
}

.thumb-empty .xy-placeholder-cat {
  width: 96rpx;
  height: 96rpx;
}

.info {
  display: flex;
  min-width: 0;
  min-height: 236rpx;
  flex: 1;
  flex-direction: column;
  padding: 0;
}

.has-litter .info {
  padding-top: 26rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: var(--xy-color-primary);
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.25;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.name {
  display: block;
  margin-top: 0;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.meta-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  row-gap: 8rpx;
  margin-top: 16rpx;
}

.meta-item {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 10rpx;
}

.meta-label,
.meta-value {
  overflow: hidden;
  font-size: 23rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-label {
  flex-shrink: 0;
  color: var(--xy-color-muted);
}

.meta-value {
  min-width: 0;
  color: var(--xy-color-text);
}

.detail {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  box-sizing: border-box;
  width: auto;
  min-height: 34rpx;
  margin-top: auto;
  padding-top: 18rpx;
  border: 0;
  border-radius: 0;
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 28rpx;
  line-height: 1;
}

.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 45;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.questionnaire-icon {
  position: absolute;
  left: calc(50% - 142rpx);
  top: 48rpx;
  z-index: 1;
  width: 32rpx;
  height: 32rpx;
  pointer-events: none;
}

.questionnaire-icon-art {
  width: 100%;
  height: 100%;
  transform: scale(1.35);
  transform-origin: center;
}

.questionnaire-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  height: var(--xy-primary-cta-height);
  box-sizing: border-box;
  margin: 0 !important;
  border-radius: var(--xy-primary-cta-radius);
  background: var(--xy-primary-cta-background);
  color: var(--xy-primary-cta-color);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  box-shadow: var(--xy-primary-cta-shadow);
}
