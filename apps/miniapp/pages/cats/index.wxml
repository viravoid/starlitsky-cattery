<view class="page">
  <view class="header">
    <text class="eyebrow">Our Cats</text>
    <text class="title">我们的猫</text>
  </view>

  <view class="sticky-controls">
    <view class="tabs">
      <button class="{{activeTab === 'kittens' ? 'tab active' : 'tab'}}" data-tab="kittens" bindtap="switchTab">
        <text class="tab-label">小猫找家</text>
        <text wx:if="{{activeTab === 'kittens'}}" class="tab-line"></text>
      </button>
      <button class="{{activeTab === 'studs' ? 'tab active' : 'tab'}}" data-tab="studs" bindtap="switchTab">
        <text class="tab-label">种猫介绍</text>
        <text wx:if="{{activeTab === 'studs'}}" class="tab-line"></text>
      </button>
    </view>

    <view wx:if="{{activeTab === 'kittens'}}" class="kitten-filter-entry">
      <button class="{{hasKittenFilters ? 'entry-button' : 'entry-button active-filter'}}" bindtap="showAllKittens">全部</button>
      <button class="{{hasKittenFilters ? 'entry-button active-filter' : 'entry-button'}}" bindtap="toggleKittenFilterPanel">
        筛选
        <text class="{{filterPanelOpen ? 'litter-chevron open' : 'litter-chevron'}}">⌄</text>
      </button>
    </view>

    <view wx:if="{{activeTab === 'kittens' && filterPanelOpen}}" class="filter-panel">
      <view class="filter-section">
        <text class="filter-section-title">状态</text>
        <view class="filter-options">
          <button wx:for="{{kittenStatusFilters}}" wx:key="*this" class="{{activeFilter === item ? 'filter active-filter' : 'filter'}}" data-filter="{{item}}" bindtap="setStatusFilter">
            {{item}}
          </button>
        </view>
      </view>
      <view class="filter-section">
        <text class="filter-section-title">窝次</text>
        <scroll-view class="litter-row-scroll" scroll-x enable-flex>
          <view class="filter-options scroll-options">
            <button wx:for="{{litterFilters}}" wx:key="id" class="{{activeLitterId === item.id ? 'filter active-filter' : 'filter'}}" data-id="{{item.id}}" bindtap="setLitter">
              {{item.name}}
            </button>
          </view>
        </scroll-view>
      </view>
      <view class="filter-section">
        <text class="filter-section-title">性别</text>
        <view class="filter-options">
          <button wx:for="{{genderFilters}}" wx:key="id" class="{{activeGenderId === item.id ? 'filter active-filter' : 'filter'}}" data-id="{{item.id}}" bindtap="setGender">
            {{item.name}}
          </button>
        </view>
      </view>
    </view>

    <view wx:if="{{activeTab === 'studs'}}" class="stud-filter-row">
      <button wx:for="{{studFilters}}" wx:key="value" class="{{activeFilter === item.value ? 'filter active-filter' : 'filter'}}" data-filter="{{item.value}}" bindtap="setStudFilter">
        {{item.label}}
      </button>
    </view>
  </view>

  <view wx:if="{{isLoading}}" class="state">正在加载猫咪资料...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{!visibleItems.length}}" class="empty-card">
    <image class="empty-art" src="../../assets/illustrations/curled-cat-blue.png" mode="aspectFit" />
    <text class="empty-title">暂无可展示猫咪</text>
  </view>

  <view wx:else class="list">
    <button wx:for="{{visibleItems}}" wx:key="id" class="cat-row {{item.litterName ? 'has-litter' : ''}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="openCat">
      <view wx:if="{{item.litterName}}" class="card-pills">
        <text class="pill litter-pill">{{item.litterName}}</text>
      </view>
      <view class="thumb">
        <image
          wx:if="{{item.imageUrl}}"
          class="{{item.imageClass}}"
          src="{{item.imageUrl}}"
          mode="{{item.imageMode}}"
          style="{{item.imageStyle}}"
        />
        <view wx:else class="thumb-empty xy-soft-placeholder">
          <image class="xy-placeholder-cat" src="../../assets/placeholder-cat.png" mode="aspectFit" />
        </view>
      </view>
      <view class="info">
        <text class="name">{{item.name}}</text>
        <view class="meta-grid">
          <view wx:for="{{item.metaItems}}" wx:key="label" class="meta-item">
            <text class="meta-label">{{item.label}}</text>
            <text class="meta-value">{{item.value}}</text>
          </view>
        </view>
        <view class="detail">
          <text>了解详情</text>
          <text class="detail-arrow">›</text>
        </view>
      </view>
    </button>
  </view>

  <view class="bottom-cta">
    <view class="questionnaire-icon">
      <image class="questionnaire-icon-art" src="../../assets/illustrations/paper-icon-white.png" mode="aspectFit" />
    </view>
    <button class="questionnaire-button" bindtap="openQuestionnaire">填写选猫问卷</button>
  </view>
</view>
