.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(86rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  display: flex;
  flex-direction: column;
  margin-bottom: 26rpx;
}

.eyebrow {
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.title {
  margin-top: 10rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.state {
  padding: 80rpx 20rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.account::after {
  border: 0;
}

.cover-image {
  display: block;
  width: 100%;
  height: 480rpx;
  margin-bottom: 28rpx;
  border-radius: 44rpx;
  background: var(--xy-gradient-cream);
  box-shadow: var(--xy-shadow-card);
}

.contact-intro,
.footer,
.body-card,
.section-card {
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.contact-intro {
  padding: 30rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.9;
  text-align: center;
}

.facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.fact {
  min-height: 116rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-text);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
  box-shadow: var(--xy-shadow-card);
}

.fact-art {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  opacity: 0.36;
  mix-blend-mode: multiply;
}

.body-card {
  padding: 34rpx 30rpx;
  background: var(--xy-gradient-cream);
}

.body,
.section-body {
  white-space: pre-line;
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 2;
}

.section-list,
.accounts {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 26rpx;
}

.gallery {
  display: flex;
  margin-top: 30rpx;
  white-space: nowrap;
}

.gallery-image {
  width: 314rpx;
  height: 236rpx;
  margin-right: 18rpx;
  border-radius: 28rpx;
  background: var(--xy-gradient-cream);
  box-shadow: var(--xy-shadow-card);
}

.section-card {
  padding: 30rpx;
}

.section-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--xy-color-heading);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.32;
}

.section-media-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.section-media-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-media-title {
  color: var(--xy-color-accent-text);
  font-size: 24rpx;
  font-weight: 700;
}

.section-media-strip {
  display: flex;
  white-space: nowrap;
}

.section-media-image {
  width: 322rpx;
  height: 242rpx;
  margin-right: 18rpx;
  border-radius: 28rpx;
  background: var(--xy-gradient-cream);
}

.account {
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr) 64rpx;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-surface);
  text-align: left;
  box-shadow: var(--xy-shadow-card);
}

.account-label {
  color: var(--xy-color-heading);
  font-size: 25rpx;
  font-weight: 700;
}

.account-value {
  overflow: hidden;
  color: var(--xy-color-text);
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy {
  color: var(--xy-color-violet);
  font-size: 24rpx;
  font-weight: 700;
}

.footer {
  margin-top: 30rpx;
  padding: 26rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.8;
  text-align: center;
}
