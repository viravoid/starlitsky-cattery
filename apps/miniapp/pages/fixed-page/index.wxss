.page {
  min-height: 100vh;
  padding: 0 0 calc(96rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
  color: var(--xy-color-text);
}

.section {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.state {
  padding: 96rpx 40rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
}

.retry-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
}

.retry-button::after,
.environment-card::after,
.feeding-image-button::after,
.copy-row::after,
.contract-action::after,
.stud-card::after {
  border: 0;
}

.image-fill {
  display: block;
  width: 100%;
  height: 100%;
}

.placeholder,
.dashed-empty,
.contract-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed var(--xy-color-border);
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.65;
  text-align: center;
}

.xy-placeholder-cat {
  width: 112rpx;
  height: 112rpx;
  opacity: 0.46;
}

.section-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin-bottom: 20rpx;
}

.section-title-wrap.with-icon,
.section-title-icon-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.section-title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

.section-en,
.body-eyebrow,
.breeding-eyebrow,
.group-eyebrow {
  display: block;
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 22rpx;
  letter-spacing: 5rpx;
  line-height: 1.35;
  text-transform: uppercase;
}

.body-eyebrow {
  color: var(--xy-color-heading);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.section-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
}

.inline-icon {
  width: 26rpx;
  height: 26rpx;
}

.tiny-icon {
  width: 24rpx;
  height: 24rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.card-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-stack.compact {
  gap: 20rpx;
}

.about-hero-section {
  padding-top: 8rpx;
}

.about-hero {
  overflow: hidden;
  width: 100%;
  border-radius: 32rpx;
  background: var(--xy-gradient-cream);
  box-shadow: var(--xy-shadow-card);
}

.about-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.about-facts-section {
  margin-top: 14rpx;
}

.about-facts-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.about-fact {
  min-height: 176rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 32rpx;
}

.about-fact-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  opacity: 0.58;
}

.about-fact-icon-aftercare {
  opacity: 1;
  transform: scale(1.3);
}

.about-fact-icon-screening {
  opacity: 0.74;
  transform: scale(1.28);
}

.about-fact-text {
  color: var(--xy-color-text);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.5;
}

.about-owner-section {
  margin-top: 36rpx;
}

.owner-card {
  padding: 28rpx;
  border-radius: 32rpx;
}

.owner-title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}

.owner-body {
  display: block;
  margin-top: 12rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.about-body-section {
  margin-top: 56rpx;
  margin-bottom: 64rpx;
}

.about-paragraphs,
.philosophy-stack {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.about-body {
  display: block;
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 1.85;
}

.philosophy-section {
  padding-top: 40rpx;
  padding-bottom: 72rpx;
}

.philosophy-body {
  display: block;
  color: var(--xy-color-text);
  font-size: 28rpx;
  line-height: 1.9;
}

.environment-intro-section {
  padding-top: 8rpx;
}

.environment-intro-card {
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--xy-gradient-cream);
}

.environment-intro,
.feeding-intro {
  display: block;
  margin-top: 18rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.8;
}

.environment-tags {
  margin-top: 20rpx;
}

.environment-list-section {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
  margin-bottom: 64rpx;
}

.environment-card {
  display: block;
  width: 100%;
  padding: 28rpx;
  border-radius: 32rpx;
  text-align: left;
}

.environment-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 14rpx;
}

.environment-card-title {
  color: var(--xy-color-heading);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.environment-chevron {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.72;
}

.environment-summary {
  display: block;
  margin-top: 18rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.environment-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 24rpx;
  color: var(--xy-color-heading);
  font-size: 26rpx;
  font-weight: 600;
}

.feeding-intro-section {
  padding-top: 16rpx;
}

.feeding-modules {
  margin-top: 40rpx;
  padding-bottom: 64rpx;
}

.feeding-module-section {
  margin-bottom: 32rpx;
}

.feeding-card {
  padding: 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 253, 248, 0.85);
}

.module-head {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.module-no {
  width: 44rpx;
  flex-shrink: 0;
  color: var(--xy-color-accent-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.module-copy {
  min-width: 0;
  flex: 1;
}

.module-title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
}

.module-body {
  display: block;
  margin-top: 10rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.feeding-image-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feeding-image-button {
  display: block;
  width: 100%;
  padding: 14rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 28rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.feeding-image {
  display: block;
  width: 100%;
  border-radius: 24rpx;
}

.feeding-placeholder {
  height: 430rpx;
  border-radius: 24rpx;
}

.dashed-empty {
  min-height: 180rpx;
  border-radius: 32rpx;
}

.process-stack,
.aftercare-stack {
  display: flex;
  flex-direction: column;
}

.process-section,
.aftercare-section {
  margin-top: 40rpx;
}

.process-section:first-child,
.aftercare-section:first-child {
  margin-top: 8rpx;
}

.process-intro {
  display: block;
  margin-bottom: 20rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.7;
  white-space: pre-line;
}

.price-card {
  padding: 28rpx;
  border-radius: 32rpx;
}

.tone-sky {
  background: rgba(212, 231, 242, 0.35);
}

.tone-creamblue {
  background: rgba(230, 239, 242, 0.62);
}

.tone-sunny {
  background: rgba(255, 232, 166, 0.45);
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24rpx;
}

.price-label {
  color: var(--xy-color-text);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  white-space: pre-line;
}

.price-value {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: right;
  white-space: pre-line;
}

.price-note {
  display: block;
  margin-top: 12rpx;
  color: var(--xy-color-text);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-line;
}

.simple-grid {
  display: grid;
  gap: 16rpx;
}

.simple-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.simple-grid.four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.simple-card {
  min-width: 0;
  padding: 24rpx;
  border-radius: 32rpx;
}

.returning-card {
  min-height: 148rpx;
  display: flex;
  flex-direction: column;
  text-align: center;
}

.simple-label {
  display: block;
  color: var(--xy-color-text);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
  white-space: pre-line;
}

.simple-value {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: pre-line;
}

.steps {
  position: relative;
  padding-left: 16rpx;
}

.step-line {
  position: absolute;
  top: 16rpx;
  bottom: 16rpx;
  left: 52rpx;
  width: 1rpx;
  background: var(--xy-color-border);
}

.step-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.step-no {
  z-index: 1;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
  box-shadow: var(--xy-shadow-card);
}

.step-card {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  border-radius: 28rpx;
}

.step-title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.45;
}

.step-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.65;
  white-space: pre-line;
}

.welcome-card {
  padding: 28rpx;
  border-radius: 32rpx;
}

.welcome-pills {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.welcome-pill {
  min-width: 176rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--xy-color-muted-bg);
  color: var(--xy-color-text);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.45;
  text-align: center;
  white-space: pre-line;
}

.welcome-note {
  display: block;
  margin-top: 24rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.65;
  white-space: pre-line;
}

.process-notice-section,
.aftercare-notice-section {
  margin-top: 40rpx;
  margin-bottom: 64rpx;
}

.notice-card,
.breeding-notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 232, 166, 0.4);
  color: var(--xy-color-accent-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.notice-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.promise-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 32rpx;
}

.promise-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  opacity: 0.72;
}

.promise-text,
.health-row {
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-line;
}

.health-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
}

.health-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.bullet {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
}

.contract-card {
  padding: 28rpx;
  border-radius: 32rpx;
}

.contract-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.contract-copy {
  min-width: 0;
}

.contract-title {
  display: block;
  color: var(--xy-color-heading);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.45;
}

.contract-file {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.contract-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 232, 166, 0.45);
  color: var(--xy-color-accent-text);
  font-size: 22rpx;
  font-weight: 600;
}

.contract-empty {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--xy-color-background);
}

.contract-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.contract-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-background);
  color: var(--xy-color-heading);
  font-size: 25rpx;
  font-weight: 700;
  min-height: 70rpx;
  line-height: 1.2;
}

.contract-action.primary {
  border-color: var(--xy-color-primary);
  background: var(--xy-color-primary);
  color: #ffffff;
}

.contact-hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 16rpx;
  text-align: center;
}

.contact-art {
  width: 88rpx;
  height: 88rpx;
}

.contact-title {
  display: block;
  margin-top: 20rpx;
  color: var(--xy-color-heading);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.contact-intro {
  display: block;
  max-width: 544rpx;
  margin-top: 18rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.9;
}

.contact-account-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 40rpx;
}

.copy-row {
  display: grid;
  grid-template-columns: 144rpx minmax(0, 1fr) 64rpx;
  align-items: center;
  gap: 18rpx;
  width: 100%;
  padding: 24rpx;
  border-radius: 32rpx;
  text-align: left;
}

.copy-label {
  color: var(--xy-color-heading);
  font-size: 25rpx;
  font-weight: 700;
}

.copy-value {
  overflow: hidden;
  color: var(--xy-color-text);
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.copy-action {
  color: var(--xy-color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.contact-footer-section {
  margin-top: 48rpx;
  margin-bottom: 64rpx;
}

.contact-footer-card {
  padding: 28rpx;
  border-radius: 32rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.95;
  text-align: center;
}

.breeding-hero-section {
  padding-top: 28rpx;
  text-align: center;
}

.breeding-eyebrow {
  color: var(--xy-color-heading);
  font-size: 20rpx;
  letter-spacing: 8rpx;
}

.breeding-period {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-heading);
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.18;
}

.breeding-rule {
  width: 112rpx;
  height: 1rpx;
  margin: 32rpx auto 0;
  background: rgba(231, 193, 93, 0.45);
}

.breeding-intro,
.breeding-tip {
  display: block;
  max-width: 576rpx;
  margin: 32rpx auto 0;
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 1.9;
}

.breeding-tip {
  padding: 16rpx 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.7);
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.breeding-group-section {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 56rpx;
}

.native-paw-trail {
  width: 100%;
  margin-bottom: 32rpx;
}

.paw-trail-image {
  display: block;
  width: 100%;
}

.breeding-group-title {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-heading);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
}

.breeding-group-desc {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.8;
}

.pairing-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.pairing-card {
  overflow: hidden;
  border-radius: 36rpx;
  background: rgba(255, 253, 248, 0.85);
}

.pairing-time-row {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx dashed rgba(233, 221, 191, 0.75);
  background: rgba(255, 248, 232, 0.45);
}

.time-pill {
  display: inline-block;
}

.pairing-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 72rpx minmax(0, 1fr);
  align-items: stretch;
  gap: 16rpx;
  padding: 24rpx 24rpx 0;
}

.stud-card {
  min-width: 0;
  box-sizing: border-box;
  padding: 16rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 28rpx;
  background: rgba(255, 248, 232, 0.9);
  text-align: center;
}

.stud-image-frame,
.stud-image {
  display: block;
  width: 100%;
  height: 196rpx;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.stud-image-frame {
  position: relative;
  overflow: hidden;
}

.manual-crop-image {
  position: absolute;
  max-width: none;
}

.stud-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.stud-role {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-muted);
  font-size: 21rpx;
  font-weight: 500;
}

.stud-name {
  display: block;
  margin-top: 4rpx;
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
}

.stud-color {
  display: block;
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 22rpx;
  line-height: 1.55;
  word-break: break-all;
}

.pairing-join {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.pairing-plus {
  width: 48rpx;
  height: 48rpx;
}

.pairing-line {
  width: 100%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(231, 193, 93, 0.4), transparent);
}

.colors-card {
  margin: 24rpx;
  padding: 22rpx;
  border: 1rpx dashed rgba(233, 221, 191, 0.9);
  border-radius: 28rpx;
  background: rgba(255, 248, 232, 0.35);
}

.colors-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.colors-title {
  color: var(--xy-color-heading);
  font-size: 25rpx;
  font-weight: 600;
}

.colors-empty-label {
  color: var(--xy-color-muted);
  font-size: 21rpx;
}

.color-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.color-note {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(233, 221, 191, 0.6);
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.8;
}

.color-note-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  color: var(--xy-color-muted);
  font-size: 21rpx;
  font-weight: 500;
}

.breeding-notice-section {
  margin-top: 48rpx;
  margin-bottom: 96rpx;
}

.notice-text {
  display: block;
  margin-bottom: 16rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.85;
}

.generic-header {
  display: flex;
  flex-direction: column;
  padding: 34rpx 40rpx 26rpx;
}

.generic-eyebrow {
  color: var(--xy-color-accent-text);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 21rpx;
  letter-spacing: 5rpx;
  text-transform: uppercase;
}

.generic-title {
  margin-top: 10rpx;
  color: var(--xy-color-heading);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.22;
}

.cover-image {
  display: block;
  width: calc(100% - 80rpx);
  height: 480rpx;
  margin: 0 40rpx 24rpx;
  border-radius: 32rpx;
  background: var(--xy-gradient-cream);
  box-shadow: var(--xy-shadow-card);
}

.body-card,
.section-card {
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--xy-gradient-cream);
}

.body {
  white-space: pre-line;
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 1.85;
}

.section-card {
  margin-top: 26rpx;
  background: var(--xy-color-surface);
}

.generic-section-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--xy-color-heading);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.32;
}
