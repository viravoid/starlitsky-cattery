.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(72rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  display: flex;
  flex-direction: column;
  margin-bottom: 34rpx;
}

.eyebrow {
  color: #b48725;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.title {
  margin-top: 10rpx;
  color: #41546c;
  font-size: 48rpx;
  font-weight: 700;
}

.intro {
  margin-top: 18rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.8;
}

.group {
  margin-top: 34rpx;
}

.group-title {
  display: block;
  margin-bottom: 18rpx;
  color: #41546c;
  font-size: 32rpx;
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 22rpx;
  background: var(--xy-color-surface);
}

.label {
  color: #41546c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.55;
}

.required,
.field-error,
.error-banner {
  color: #b42318;
}

.control,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 16rpx;
  background: #fffdf8;
  color: var(--xy-color-text);
  font-size: 26rpx;
}

.control {
  height: 78rpx;
  padding: 0 20rpx;
}

.textarea {
  min-height: 150rpx;
  padding: 18rpx 20rpx;
  line-height: 1.7;
}

.choice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.choice {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.6;
}

.field-error {
  font-size: 22rpx;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #f3b7b7;
  border-radius: 18rpx;
  background: #fff4f4;
  font-size: 24rpx;
}

.retry-button,
.secondary-action {
  min-width: 168rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
}

.retry-button::after,
.secondary-action::after,
.submit::after {
  border: 0;
}

.ps {
  margin-top: 30rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.8;
}

.submit {
  width: 100%;
  margin-top: 34rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.success {
  min-height: 78vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.success-mark {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #e8f3ff;
  color: var(--xy-color-primary);
  font-size: 64rpx;
  font-weight: 700;
}

.success-title {
  margin-top: 30rpx;
  color: #41546c;
  font-size: 34rpx;
  font-weight: 700;
}

.success-body {
  margin-top: 16rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.8;
}

.secondary-action {
  margin-top: 34rpx;
}
