.page {
  min-height: 100vh;
  padding: 34rpx 30rpx calc(276rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 6rpx;
}

.heart {
  width: 48rpx;
  height: 48rpx;
}

.title {
  color: var(--xy-color-heading);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
}

.intro-card {
  margin-top: 22rpx;
  padding: 30rpx;
  border-radius: 40rpx;
  background: var(--xy-gradient-cream);
}

.intro {
  color: var(--xy-color-text);
  font-size: 25rpx;
  line-height: 1.9;
}

.privacy-notice {
  display: block;
  margin-top: 16rpx;
  color: var(--xy-color-muted);
  font-size: 23rpx;
  line-height: 1.65;
}

.group {
  margin-top: 64rpx;
}

.first-group {
  margin-top: 18rpx;
}

.group-heading {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.group-no {
  color: rgba(154, 163, 207, 0.78);
  font-family: "Songti SC", "PingFang SC", serif;
  font-size: 26rpx;
  font-weight: 700;
}

.group-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.label {
  color: var(--xy-color-heading);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
}

.commitment-card {
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: rgba(255, 253, 248, 0.6);
}

.commitment-label {
  color: var(--xy-color-text);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.9;
}

.required,
.field-error,
.error-banner {
  color: #b42318;
}

.control,
.textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 32rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-text);
  font-size: 28rpx;
  box-shadow: var(--xy-shadow-card);
}

.control {
  height: 86rpx;
  padding: 0 28rpx;
}

.textarea {
  min-height: 180rpx;
  padding: 24rpx 28rpx;
  line-height: 1.7;
}

.choice-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.commitment-choice-list {
  margin-top: 4rpx;
}

.choice {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  max-width: 100%;
  min-height: 58rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-muted);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.35;
}

.choice.selected {
  border-color: var(--xy-color-primary);
  background: var(--xy-color-primary);
  color: #ffffff;
  box-shadow: var(--xy-shadow-card);
}

.native-radio {
  display: none;
}

.field-error {
  font-size: 22rpx;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #f3b7b7;
  border-radius: 28rpx;
  background: #fff4f4;
  font-size: 24rpx;
}

.retry-button,
.secondary-action {
  min-width: 168rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 64rpx;
}

.retry-button::after,
.secondary-action::after,
.submit::after {
  border: 0;
}

.ps {
  margin-top: 34rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
  line-height: 1.9;
}

.bottom-cta {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 4;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--xy-color-border);
  background: rgba(255, 253, 248, 0.96);
}

.submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  border-radius: 999rpx;
  background: var(--xy-color-violet);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.submit-icon {
  width: 38rpx;
  height: 38rpx;
}

.submit[disabled] {
  background: #c6cbd2;
}

.success {
  min-height: 78vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
}

.success-mark {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(122, 154, 192, 0.25);
}

.success-icon {
  width: 78rpx;
  height: 78rpx;
}

.success-title {
  margin-top: 34rpx;
  color: var(--xy-color-heading);
  font-size: 34rpx;
  font-weight: 700;
}

.success-body {
  margin-top: 16rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.8;
}

.secondary-action {
  margin-top: 34rpx;
}
