<view class="page">
  <view wx:if="{{submitted}}" class="success">
    <view class="success-mark">
      <image class="success-icon" src="../../assets/illustrations/check-icon.png" mode="aspectFit" />
    </view>
    <text class="success-title">{{successTitle}}</text>
    <text class="success-body">{{successBody}}</text>
    <view class="secondary-action" bindtap="resetForm">返回问卷</view>
  </view>

  <view wx:else>
    <view class="header">
      <image class="heart" src="../../assets/illustrations/heart-icon.png" mode="aspectFit" />
      <text class="title">选猫问卷</text>
    </view>

    <view class="intro-card">
      <text wx:if="{{intro}}" class="intro">{{intro}}</text>
      <text wx:if="{{privacyNotice}}" class="privacy-notice">{{privacyNotice}}</text>
    </view>

    <view wx:if="{{error}}" class="error-banner">
      <text>{{error}}</text>
      <view wx:if="{{showRetry && !isSubmitting}}" class="retry-button" bindtap="retrySubmit">重试提交</view>
    </view>

    <view wx:for="{{groups}}" wx:key="title" class="{{index === 0 ? 'group first-group' : 'group'}}">
      <view class="group-heading">
        <text class="group-no">{{item.no}}</text>
        <text class="group-title">{{item.title}}</text>
      </view>
      <view wx:for="{{item.questions}}" wx:for-item="question" wx:key="key" class="{{question.type === 'commitment' ? 'field commitment-card' : 'field'}}" wx:if="{{question.key !== 'residentsNeutered' || values.residents === 'yes'}}">
        <text class="{{question.type === 'commitment' ? 'label commitment-label' : 'label'}}">
          {{question.label}}
          <text wx:if="{{question.required}}" class="required">*</text>
        </text>

        <input
          wx:if="{{question.type === 'text'}}"
          class="control"
          type="{{question.inputType}}"
          value="{{values[question.key]}}"
          placeholder="{{question.placeholder}}"
          data-key="{{question.key}}"
          bindinput="onInput"
        />

        <textarea
          wx:elif="{{question.type === 'textarea'}}"
          class="textarea"
          value="{{values[question.key]}}"
          placeholder="{{question.placeholder}}"
          data-key="{{question.key}}"
          bindinput="onInput"
        />

        <radio-group
          wx:else
          class="{{question.type === 'commitment' ? 'choice-list commitment-choice-list' : 'choice-list'}}"
          data-key="{{question.key}}"
          bindchange="onChoice"
        >
          <label wx:for="{{question.options}}" wx:for-item="option" wx:key="value" class="{{values[question.key] === option.value ? 'choice selected' : 'choice'}}">
            <radio class="native-radio" value="{{option.value}}" checked="{{values[question.key] === option.value}}" color="#7a9ac0" />
            <text>{{option.label}}</text>
          </label>
        </radio-group>

        <text wx:if="{{errors[question.key]}}" class="field-error">{{errors[question.key]}}</text>
      </view>
    </view>

    <view wx:if="{{ps}}" class="ps">
      <text>{{ps}}</text>
    </view>

    <view class="bottom-cta">
      <view class="{{isSubmitting ? 'submit disabled' : 'submit'}}" bindtap="onSubmit">
        <image class="submit-icon" src="../../assets/illustrations/paper-icon-white.png" mode="aspectFit" />
        {{isSubmitting ? "提交中..." : "提交选猫问卷"}}
      </view>
    </view>
  </view>
</view>
