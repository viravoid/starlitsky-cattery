<view class="page">
  <view wx:if="{{isLoading}}" class="state">正在加载猫咪详情...</view>
  <view wx:elif="{{error}}" class="state error-state">
    <text class="error">{{error}}</text>
    <button class="retry-button" bindtap="retryLoad">重试</button>
  </view>
  <view wx:elif="{{needsParentAuth}}" class="state auth-state">
    <image class="auth-art" src="../../assets/placeholder-cat.png" mode="aspectFit" />
    <text class="auth-title">尚未完成家长认证</text>
    <text class="auth-copy">完成家长认证后，才能查看自己的猫咪详情。</text>
    <button class="auth-button" bindtap="openParentAuth">去家长认证</button>
  </view>

  <view wx:else>
    <view class="profile">
      <image wx:if="{{imageUrl}}" class="hero-image" src="{{imageUrl}}" mode="aspectFill" />
      <view wx:else class="hero-empty xy-soft-placeholder">
        <image class="xy-placeholder-cat" src="../../assets/placeholder-cat.png" mode="aspectFit" />
      </view>
      <view class="profile-copy">
        <view class="name-row">
          <text class="name">{{name}}</text>
          <text class="{{genderClass}}">{{gender}}</text>
        </view>
        <text class="meta">{{color}} · 生日 {{birthday || '待补充'}}</text>
        <text class="meta secondary">{{secondaryMeta}}</text>
        <text wx:if="{{relationshipStartedAt}}" class="meta secondary">到家 {{relationshipStartedAt}}</text>
        <text wx:if="{{personality}}" class="personality">{{personality}}</text>
      </view>
    </view>

    <view class="timeline">
      <view class="timeline-head">
        <text class="timeline-title">{{name}} 的动态 · {{timelinePosts.length}} 条</text>
      </view>
      <view wx:if="{{!timelinePosts.length}}" class="empty-timeline">暂无关联动态</view>
      <view
        wx:for="{{timelinePosts}}"
        wx:key="id"
        wx:for-index="index"
        class="post-card"
        data-id="{{item.id}}"
        bindtap="openPost"
      >
        <view class="post-head">
          <view class="author-block">
            <view class="author-row">
              <text class="author">{{item.author}}</text>
              <text wx:if="{{item.roleLabel}}" class="{{item.roleClass}}">{{item.roleLabel}}</text>
              <text wx:if="{{item.isPinned}}" class="pin">置顶</text>
            </view>
            <text class="post-date">{{item.date}}</text>
          </view>
          <text class="post-category">{{item.category}}</text>
        </view>

        <text class="post-content">{{item.content}}</text>

        <view wx:if="{{item.images.length}}" class="{{item.imageGridClass}}">
          <image
            wx:for="{{item.images}}"
            wx:for-item="image"
            wx:for-index="imageIndex"
            wx:key="id"
            class="post-image"
            src="{{image.url}}"
            mode="aspectFill"
            data-post-index="{{index}}"
            data-image-index="{{imageIndex}}"
            catchtap="previewPostImage"
          />
        </view>

        <view wx:if="{{item.linkedLitters.length || item.linkedCats.length}}" class="links">
          <view wx:for="{{item.linkedCats}}" wx:key="id" class="cat-link-pill">
            <view class="cat-avatar">
              <image class="cat-avatar-icon" src="../../assets/illustrations/cat-icon.png" mode="aspectFit" />
            </view>
            <text>{{item.name}}</text>
          </view>
          <text wx:for="{{item.linkedLitters}}" wx:key="id" class="link-pill litter">{{item.name}}</text>
        </view>

        <view class="post-foot">
          <view class="{{item.likedByMe ? 'like-action liked' : 'like-action'}}">
            <image
              class="foot-icon"
              src="{{item.likedByMe ? '../../assets/illustrations/paw-like-active.png' : '../../assets/illustrations/paw-like.png'}}"
              mode="aspectFit"
            />
            <text>{{item.footerLikeLabel}}</text>
          </view>
          <view class="comment-count">
            <image class="foot-icon" src="../../assets/illustrations/chat-bubble-icon.png" mode="aspectFit" />
            <text>{{item.footerCommentLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <button class="more-link" bindtap="openPublicCats">想看更多？前往我们的猫查看猫舍现猫资料。</button>
  </view>
</view>
