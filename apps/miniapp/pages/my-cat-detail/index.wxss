.page {
  min-height: 100vh;
  padding: 30rpx 24rpx calc(88rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 120rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.auth-title {
  color: #41546c;
  font-size: 29rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.55;
}

.retry-button,
.auth-button {
  min-width: 176rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--xy-color-primary);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.retry-button::after,
.auth-button::after,
.post-card::after {
  border: 0;
}

.hero {
  overflow: hidden;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
}

.hero-image,
.hero-empty {
  width: 100%;
  height: 440rpx;
}

.hero-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6ecd3;
  color: #b48725;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-copy {
  padding: 24rpx 22rpx 26rpx;
}

.relationship,
.name,
.meta,
.info-label,
.info-value,
.timeline-title,
.timeline-count,
.post-category,
.post-date,
.post-content,
.post-meta {
  display: block;
}

.relationship,
.post-category {
  width: fit-content;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f9f0d4;
  color: #b48725;
  font-size: 21rpx;
  font-weight: 700;
}

.name {
  margin-top: 12rpx;
  color: #41546c;
  font-size: 42rpx;
  font-weight: 700;
}

.meta {
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
}

.info-panel {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
}

.info-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--xy-color-border);
}

.info-row:last-child {
  border-bottom: 0;
}

.info-row.vertical {
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  flex-shrink: 0;
  width: 96rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.timeline {
  margin-top: 26rpx;
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.timeline-title {
  color: #41546c;
  font-size: 32rpx;
  font-weight: 700;
}

.timeline-count {
  color: var(--xy-color-muted);
  font-size: 23rpx;
}

.empty-timeline {
  padding: 46rpx 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-muted);
  font-size: 25rpx;
  text-align: center;
}

.post-card {
  display: flex;
  gap: 18rpx;
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 24rpx;
  background: var(--xy-color-surface);
  text-align: left;
}

.post-main {
  flex: 1;
  min-width: 0;
}

.post-date {
  margin-top: 8rpx;
  color: var(--xy-color-muted);
  font-size: 22rpx;
}

.post-content {
  margin-top: 10rpx;
  color: var(--xy-color-text);
  font-size: 26rpx;
  line-height: 1.55;
}

.post-meta {
  margin-top: 10rpx;
  color: var(--xy-color-muted);
  font-size: 23rpx;
}

.post-image {
  flex-shrink: 0;
  width: 156rpx;
  height: 156rpx;
  border-radius: 18rpx;
  background: #f6ecd3;
}
