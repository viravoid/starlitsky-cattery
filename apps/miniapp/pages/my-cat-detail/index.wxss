.page {
  min-height: 100vh;
  padding: 32rpx 40rpx calc(88rpx + env(safe-area-inset-bottom));
  background: var(--xy-color-background);
}

.state {
  padding: 104rpx 24rpx;
  color: var(--xy-color-muted);
  font-size: 26rpx;
  text-align: center;
}

.error {
  color: #b42318;
}

.error-state,
.auth-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 72rpx;
  padding: 56rpx 36rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.auth-art {
  width: 156rpx;
  height: 156rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(231, 193, 93, 0.28);
  border-radius: 999rpx;
  background: #fff4d6;
  opacity: 1;
}

.auth-title {
  color: var(--xy-color-heading);
  font-size: 30rpx;
  font-weight: 700;
}

.auth-copy {
  max-width: 560rpx;
  color: var(--xy-color-muted);
  font-size: 25rpx;
  line-height: 1.6;
}

.retry-button,
.auth-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  min-height: 76rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  background: var(--xy-color-accent);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}

.retry-button::after,
.auth-button::after {
  border: 0;
}

.profile {
  padding: 0;
}

.hero-image,
.hero-empty {
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  border-radius: 48rpx;
  background: var(--xy-gradient-cream);
  box-shadow: var(--xy-shadow-card);
}

.profile-copy {
  padding: 24rpx 0 0;
}

.name-row,
.name,
.meta,
.timeline-title,
.author,
.post-date,
.post-category,
.post-content,
.link-pill {
  display: block;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.name {
  color: var(--xy-color-heading);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.25;
}

.gender-pill,
.role-pill,
.pin,
.post-category,
.link-pill {
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.3;
}

.gender-pill {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  background: rgba(212, 231, 242, 0.48);
  color: #6b8db3;
}

.gender-pill.female {
  background: rgba(255, 232, 166, 0.45);
  color: var(--xy-color-primary);
}

.meta {
  margin-top: 8rpx;
  color: var(--xy-color-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.meta.secondary {
  color: var(--xy-color-muted);
  font-size: 23rpx;
}

.personality {
  display: block;
  margin-top: 22rpx;
  color: var(--xy-color-text);
  font-size: 27rpx;
  line-height: 1.8;
  white-space: pre-line;
}

.timeline {
  margin-top: 34rpx;
}

.timeline-head {
  margin-bottom: 18rpx;
}

.timeline-title {
  color: var(--xy-color-secondary);
  font-size: 25rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.empty-timeline {
  padding: 46rpx 24rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 40rpx;
  background: var(--xy-color-surface);
  color: var(--xy-color-muted);
  font-size: 25rpx;
  text-align: center;
  box-shadow: var(--xy-shadow-card);
}

.post-card {
  margin-bottom: 18rpx;
  padding: 32rpx 40rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.72);
  border-radius: 48rpx;
  background: var(--xy-color-surface);
  box-shadow: var(--xy-shadow-card);
}

.post-head,
.author-row,
.links,
.post-foot,
.like-action,
.comment-count {
  display: flex;
}

.post-head {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.author-block {
  flex: 1;
  min-width: 0;
}

.author-row {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
}

.author {
  max-width: 300rpx;
  overflow: hidden;
  color: var(--xy-color-heading);
  font-size: 27rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill {
  padding: 4rpx 14rpx;
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.role-pill.keeper {
  background: rgba(134, 166, 210, 0.24);
  color: #6b8db3;
}

.pin {
  padding: 4rpx 12rpx;
  background: #fff1c9;
  color: #7a9ac0;
}

.post-category {
  flex-shrink: 0;
  color: #6f93bc;
  font-size: 21rpx;
  font-weight: 700;
}

.post-date {
  margin-top: 6rpx;
  color: var(--xy-color-secondary);
  font-size: 22rpx;
}

.post-content {
  margin-top: 24rpx;
  color: var(--xy-color-text);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.post-images {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.single-image-grid {
  grid-template-columns: 1fr;
}

.two-image-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.three-image-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.post-image {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 24rpx;
  background: var(--xy-gradient-cream);
}

.single-image-grid .post-image {
  aspect-ratio: 4 / 3;
  border-radius: 32rpx;
}

.links {
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx 18rpx;
  margin-top: 18rpx;
}

.link-pill {
  max-width: 100%;
  padding: 8rpx 18rpx;
  background: rgba(255, 253, 248, 0.72);
  color: var(--xy-color-heading);
}

.link-pill.litter {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border: 1rpx solid #eedb9b;
  background: #fff7dd;
  color: #6f93bc;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.2;
}

.cat-link-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  max-width: 100%;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: #6b8db3;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
}

.cat-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid rgba(233, 221, 191, 0.82);
  border-radius: 999rpx;
  background: var(--xy-gradient-cream);
}

.cat-avatar-icon {
  width: 32rpx;
  height: 32rpx;
}

.post-foot {
  align-items: center;
  justify-content: flex-end;
  gap: 28rpx;
  margin-top: 22rpx;
  color: var(--xy-color-muted);
  font-size: 24rpx;
}

.like-action,
.comment-count {
  align-items: center;
  gap: 10rpx;
  color: var(--xy-color-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 52rpx;
}

.like-action.liked {
  color: #6f93bc;
}

.foot-icon {
  width: 36rpx;
  height: 36rpx;
}

.more-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-height: 64rpx;
  box-sizing: border-box;
  margin: 18rpx auto 0;
  padding: 0 26rpx;
  border: 1rpx solid var(--xy-color-border);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.78);
  color: #6f93bc;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.more-link::after {
  border: 0;
}
