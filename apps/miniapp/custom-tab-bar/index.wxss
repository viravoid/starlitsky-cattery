.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 8rpx 16rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(233, 221, 191, 0.92);
  background: #fffaf0;
}

.tab {
  display: flex;
  width: auto !important;
  height: 100%;
  min-width: 0;
  box-sizing: border-box;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  justify-self: stretch;
  margin: 0 !important;
  padding: 4rpx 0 !important;
  background: transparent;
  color: #8c929a;
  line-height: 1;
  text-align: center;
}

.tab.selected {
  color: #b48725;
}

.icon {
  width: 40rpx;
  height: 40rpx;
}

.label {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
}

.tab::after {
  border: 0;
}
