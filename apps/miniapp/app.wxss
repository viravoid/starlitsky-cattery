@import "./styles/theme.wxss";

page {
  background: var(--xy-color-background);
  color: var(--xy-color-text);
  font-family: "Quicksand", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, sans-serif;
}

view,
text,
image {
  box-sizing: border-box;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
  text-align: inherit;
}

button::after {
  border: 0;
}
