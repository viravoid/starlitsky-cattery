# Copy this file to /etc/starlitsky/starlitsky-api.env on the server.
# Replace every placeholder on the server only. Never commit real values.

NODE_ENV=production
API_HOST=127.0.0.1
API_PORT=8080

# Keep SQLite outside /opt/starlitsky/app so code releases cannot overwrite it.
DATABASE_URL="file:/opt/starlitsky/data/starlitsky.sqlite"

# Auth
AUTH_TOKEN_SECRET=replace-with-production-auth-token-secret-minimum-32-chars
AUTH_SESSION_TTL_DAYS=30
AUTH_REVOKED_SESSION_CLEANUP_DAYS=30
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
ADMIN_USERNAME=replace-with-production-admin-username
ADMIN_PASSWORD_HASH=replace-with-production-admin-password-hash
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=60000
ADMIN_LOGIN_RATE_LIMIT_MAX=8
ADMIN_LOGIN_RATE_LIMIT_MAX_BUCKETS=10000

# The API sits behind local Nginx in production, so trust exactly one proxy hop.
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# Browser CORS. Use the final Admin origin only; do not use wildcard CORS.
CORS_ALLOWED_ORIGINS=https://admin.__DOMAIN__

# WeChat Mini Program
WECHAT_APP_ID=replace-with-production-wechat-app-id
WECHAT_APP_SECRET=replace-with-production-wechat-app-secret
WECHAT_MOCK_LOGIN_ENABLED=false
WECHAT_MOCK_QR_ENABLED=false
WECHAT_MINIAPP_QR_ENV_VERSION=release
WECHAT_MINIAPP_QR_CHECK_PATH=true
WECHAT_UPSTREAM_TIMEOUT_MS=5000

# Tencent COS / S3-compatible storage
STORAGE_PROVIDER=cos
STORAGE_BUCKET=replace-with-production-cos-bucket
STORAGE_REGION=replace-with-production-cos-region
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=replace-with-production-cos-access-key-id
STORAGE_ACCESS_KEY_SECRET=replace-with-production-cos-access-key-secret
STORAGE_SESSION_TOKEN=
STORAGE_PUBLIC_BASE_URL=https://media.__DOMAIN__
STORAGE_KEY_PREFIX=media
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_EXPIRES_SECONDS=600
STORAGE_READ_EXPIRES_SECONDS=3600
STORAGE_MAX_IMAGE_BYTES=10485760
STORAGE_LEGACY_BUCKET=
STORAGE_LEGACY_ACCESS_KEY_ID=
STORAGE_LEGACY_ACCESS_KEY_SECRET=
STORAGE_LEGACY_SESSION_TOKEN=
STORAGE_READ_BUCKETS_JSON=[]
