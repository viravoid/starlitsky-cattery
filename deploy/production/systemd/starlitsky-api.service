[Unit]
Description=Starlitsky Cattery API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starlitsky
Group=starlitsky
WorkingDirectory=/opt/starlitsky/app
EnvironmentFile=/etc/starlitsky/starlitsky-api.env
Environment=NODE_ENV=production
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8080
ExecStart=/usr/bin/node /opt/starlitsky/app/services/api/src/server.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/starlitsky/data /opt/starlitsky/logs

[Install]
WantedBy=multi-user.target
