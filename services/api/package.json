{
  "name": "@starlitsky/api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/server.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node prisma/ensure-local-sqlite.mjs && prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "node prisma/ensure-local-sqlite.mjs && prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "node prisma/ensure-local-sqlite.mjs && prisma migrate status --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.mjs",
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:community": "node src/services/community-service.verify.mjs",
    "verify:migration-smoke": "node src/services/prisma-migration-smoke.verify.mjs",
    "verify:production-env": "node src/config/production-env.verify.mjs",
    "verify:security": "node src/services/security-hardening.verify.mjs",
    "verify:admin-auth": "node src/services/admin-auth-service.verify.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
