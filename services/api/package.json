{
  "name": "@starlitsky/api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/server.mjs",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node prisma/ensure-local-sqlite.mjs && prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "node prisma/ensure-local-sqlite.mjs && prisma migrate deploy --schema prisma/schema.prisma",
    "db:status": "node prisma/ensure-local-sqlite.mjs && prisma migrate status --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:seed": "node prisma/seed.mjs",
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:community": "node src/services/community-service.verify.mjs",
    "verify:media-upload": "node src/services/media-upload-service.verify.mjs",
    "verify:private-cos-read": "node src/services/private-cos-read-delivery.verify.mjs",
    "verify:cos-migration": "node src/services/object-storage-lightcos.verify.mjs && node src/services/lightcos-read-probe.verify.mjs && node src/services/cos-migration-service.verify.mjs && node src/services/offline-image-inventory.verify.mjs",
    "verify:fixed-page-media": "node src/services/fixed-page-media-service.verify.mjs",
    "verify:migration-smoke": "node src/services/prisma-migration-smoke.verify.mjs",
    "verify:production-env": "node src/config/production-env.verify.mjs",
    "verify:security": "node src/services/security-hardening.verify.mjs",
    "verify:admin-auth": "node src/services/admin-auth-service.verify.mjs",
    "verify:cat-admin-hardening": "node src/services/cat-admin-hardening.verify.mjs",
    "verify:parent-flow": "node src/services/parent-application-service.verify.mjs && node src/services/parent-application-migration.verify.mjs",
    "verify:selection-application": "node src/services/selection-application-service.verify.mjs",
    "verify:public-content-import": "node src/services/public-content-importer.verify.mjs",
    "verify:environment-media-batch": "node src/services/environment-media-batch-importer.verify.mjs",
    "import:public-content": "node src/cli/import-public-content.mjs",
    "apply:demo-recovery-update": "node src/cli/apply-demo-recovery-update.mjs",
    "media:apply-environment-batch": "node src/cli/apply-environment-media-batch.mjs",
    "media:cos-migration": "node src/cli/cos-migration.mjs",
    "media:offline-image-inventory": "node src/cli/offline-image-inventory.mjs",
    "probe:lightcos-read-only": "node src/cli/lightcos-read-probe.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cos-nodejs-sdk-v5": "3.0.0"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  }
}
