# API
API_PORT=4310
API_HOST=127.0.0.1

# Database
DATABASE_URL="file:dev.db"

# WeChat Mini Program
WECHAT_APP_ID=your-wechat-miniapp-appid
WECHAT_APP_SECRET=replace-with-local-secret-only
WECHAT_MOCK_QR_ENABLED=true
WECHAT_MINIAPP_QR_ENV_VERSION=trial
WECHAT_MINIAPP_QR_CHECK_PATH=true

# Auth
JWT_SECRET=replace-with-local-secret-only
AUTH_TOKEN_SECRET=replace-with-local-secret-only
AUTH_SESSION_TTL_DAYS=30
AUTH_REVOKED_SESSION_CLEANUP_DAYS=30
AUTH_SESSION_CLEANUP_INTERVAL_MS=3600000
ADMIN_SESSION_SECRET=replace-with-local-secret-only
WECHAT_MOCK_LOGIN_ENABLED=true
WECHAT_LOGIN_RATE_LIMIT_WINDOW_MS=60000
WECHAT_LOGIN_RATE_LIMIT_MAX=20
WECHAT_LOGIN_RATE_LIMIT_MAX_BUCKETS=10000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Object Storage
STORAGE_PROVIDER=cos
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=your-region
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=replace-with-local-key-only
STORAGE_ACCESS_KEY_SECRET=replace-with-local-secret-only
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
STORAGE_KEY_PREFIX=media
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_EXPIRES_SECONDS=600
STORAGE_MAX_IMAGE_BYTES=10485760

# Browser access. Production must list the deployed admin origin explicitly.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
WECHAT_UPSTREAM_TIMEOUT_MS=5000
